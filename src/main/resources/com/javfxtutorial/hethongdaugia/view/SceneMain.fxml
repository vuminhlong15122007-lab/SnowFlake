<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="500" prefWidth="900" style="-fx-background-color: linear-gradient(to bottom, #e6f7ff, #ffffff);" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javfxtutorial.hethongdaugia.client.controller.TrangChuController">
    <!-- Header -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="41.0" prefWidth="900.0" spacing="20" style="-fx-background-color: linear-gradient(to right, skyblue, #2f80ed); -fx-padding: 10;">
         <ImageView fitHeight="70.0" fitWidth="70.0" pickOnBounds="true" preserveRatio="true">
            <image>
               <Image url="@../assets/Logo.png" />
            </image>
         </ImageView>
            <Label style="-fx-font-size: 22px; -fx-text-fill: linear-gradient(to right, purple, #2f80ed); -fx-font-weight: bold;" text="SnowFox" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="logoutButton" onAction="#goLogin" style="-fx-background-color: #4b0082; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-weight: bold;" text="Đăng xuất" />
        </HBox>
    </top>

    <!-- Sidebar menu -->
    <left>
        <VBox spacing="15" style="-fx-padding: 15; -fx-pref-width: 180;">
            <Button fx:id="homeButton" prefHeight="27.0" prefWidth="145.0" style="-fx-background-color: linear-gradient(to right, skyblue, #2f80ed); -fx-text-fill: white; -fx-background-radius: 6; -fx-font-weight: bold;" text="Trang chủ" />
            <Button fx:id="liveAuctionButton" onAction="#goAuction" prefHeight="27.0" prefWidth="145.0" style="-fx-background-color: linear-gradient(to right, skyblue, #2f80ed); -fx-font-weight: bold; -fx-border-radius: 6; -fx-text-fill: white;" text="Phiên đấu giá " />
            <Button fx:id="manageProductsButton" onAction="#manageProducts" prefHeight="27.0" prefWidth="145.0" style="-fx-background-color: linear-gradient(to right, skyblue, #2f80ed); -fx-font-weight: bold; -fx-border-radius: 6; -fx-text-fill: white;" text="Quản lý sản phẩm" />
            <Button fx:id="profileButton" onAction="#goToProfile" prefHeight="27.0" prefWidth="145.0" style="-fx-background-color: linear-gradient(to right, skyblue, #2f80ed); -fx-font-weight: bold; -fx-border-radius: 6; -fx-text-fill: white;" text="Thông tin người dùng" />
        </VBox>
    </left>

    <!-- Nội dung chính -->
    <center>
        <StackPane style="-fx-background-color: linear-gradient(to bottom right, #ffffff, #f0faff);">
            <children>
                <VBox alignment="CENTER" spacing="5">
                    <children>
                  <Label prefHeight="85.0" prefWidth="231.0" style="-fx-font-size: 30; -fx-font-weight: bold; -fx-font-family: 'Lucida Handwriting', 'Mistral', 'Cursive'; -fx-text-fill: #34495e; -fx-effect: dropshadow(three-pass-box, rgba(47, 128, 237, 0.2), 15, 0, 0, 5); -fx-padding: 0 0 10 0;" text="WELCOME TO" textAlignment="CENTER" />
                        <Label style="-fx-font-size: 60px;                                       -fx-font-weight: bold;                                       -fx-font-family: 'Lucida Handwriting', 'Mistral', 'Cursive';                                       -fx-text-fill: linear-gradient(to right, #4b0082, #2f80ed);                                       -fx-effect: dropshadow(three-pass-box, rgba(47, 128, 237, 0.2), 15, 0, 0, 5);                                       -fx-padding: 0 0 10 0;" text="k ỉ nguyên SnowFox" textAlignment="CENTER">
                        </Label>

                        <HBox alignment="CENTER">
                            <Region prefHeight="2" prefWidth="120" style="-fx-background-color: #2f80ed; -fx-opacity: 0.3;" />
                            <Label style="-fx-text-fill: #2f80ed; -fx-font-size: 15px;" text=" ❄ " />
                            <Region prefHeight="2" prefWidth="120" style="-fx-background-color: #2f80ed; -fx-opacity: 0.3;" />
                        </HBox>

                        <Label style="-fx-font-size: 16px;                                       -fx-text-fill: #34495e;                                       -fx-font-family: 'Segoe UI Semibold';                                       -fx-opacity: 0.8;                                       -fx-padding: 10 0 0 0;" text="~ Nơi những phiên đấu giá trở nên kỳ diệu ~" />
                    </children>
                </VBox>
            </children>
        </StackPane>
    </center>

    <!-- Footer -->
    <bottom>
        <HBox alignment="CENTER" style="-fx-background-color: #b3c6ff; -fx-padding: 8;">
            <Label style="-fx-text-fill: white; -fx-font-size: 12px;" text="© 2026 SnowFox - Studio SnowFlake" />
        </HBox>
    </bottom>
</BorderPane>
