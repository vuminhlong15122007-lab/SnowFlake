<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" styleClass="admin-theme" stylesheets="@../css/global.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javfxtutorial.hethongdaugia.client.controller.AdminUserController">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="64.0" prefWidth="1280.0" spacing="12.0" styleClass="admin-header-bar" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="10.0" left="18.0" right="18.0" top="10.0" />
            </padding>

            <StackPane prefHeight="38.0" prefWidth="38.0" style="-fx-background-radius: 8;">
                <ImageView fitHeight="47.0" fitWidth="53.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../../assets/Beta01.png" />
                    </image>
                </ImageView>
            </StackPane>

            <VBox spacing="1.0">
                <Label styleClass="admin-title" text="Bảng điều khiển admin" />
                <Label styleClass="admin-subtitle" text="Quản lý tài khoản người dùng" />
            </VBox>

            <Region HBox.hgrow="ALWAYS" />

            <HBox alignment="CENTER_LEFT" spacing="6.0" styleClass="admin-search-box">
                <TextField fx:id="searchField" prefHeight="28.0" prefWidth="210.0" promptText="Tìm tên, email hoặc ID..." styleClass="admin-search-field" />
                <Button fx:id="btnSearch" mnemonicParsing="false" onAction="#clickToSearch" prefHeight="28.0" styleClass="admin-btn-search" text="Tìm" />
                <Button fx:id="dltSearch" mnemonicParsing="false" onAction="#clickToDeleteSearch" prefHeight="28.0" styleClass="admin-btn-search-clear" text="Xóa" />
            </HBox>
        </HBox>
    </top>

    <center>
        <VBox spacing="12.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <Label styleClass="admin-section-title" text="Danh sách tài khoản hệ thống" />
                <Label fx:id="userCountBadge" styleClass="admin-count-badge" text="5 người dùng" />
            </HBox>

            <TableView fx:id="userTable" styleClass="admin-user-table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="65.0" style="-fx-alignment: CENTER-LEFT; -fx-font-weight: bold;" text="ID" />
                    <TableColumn fx:id="colUsername" prefWidth="230.0" style="-fx-font-weight: bold;" text="Tên đăng nhập" />
                    <TableColumn fx:id="colEmail" prefWidth="290.0" style="-fx-font-weight: bold;" text="Email" />
                    <TableColumn fx:id="colPhone" prefWidth="180.0" style="-fx-font-weight: bold;" text="Số điện thoại" />
                    <TableColumn fx:id="colRole" prefWidth="130.0" style="-fx-font-weight: bold;" text="Vai trò" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>

    <right>
        <VBox prefWidth="240.0" spacing="10.0" styleClass="admin-sidebar-panel" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="16.0" left="14.0" right="14.0" top="16.0" />
            </padding>

            <Label styleClass="admin-nav-heading" text="ĐIỀU HƯỚNG" />

            <Button fx:id="itemAdmin" maxWidth="Infinity" mnemonicParsing="false" onAction="#clickToGoItemAdmin" styleClass="admin-btn-nav" text="📦  Quản lý sản phẩm" />

            <Separator style="-fx-opacity: 0.5; -fx-padding: 4 0 4 0;" />

            <Label styleClass="admin-nav-heading" text="QUẢN LÝ TÀI KHOẢN" />

            <Button fx:id="btnAddUser" maxWidth="Infinity" mnemonicParsing="false" onAction="#clickToAddUser" styleClass="admin-btn-add" text="➕ Thêm người dùng" />
            <Button fx:id="btnEditUser" maxWidth="Infinity" mnemonicParsing="false" onAction="#getUpdateAdmin" styleClass="admin-btn-edit" text="📝  Cập nhật thông tin Admin" />
            <Button fx:id="btnResetPassword" maxWidth="Infinity" mnemonicParsing="false" onAction="#clickToResetPW" styleClass="admin-btn-reset" text="🔓  Đặt lại mật khẩu" />
            <Button fx:id="reload" maxWidth="Infinity" mnemonicParsing="false" onAction="#reLoad" styleClass="admin-btn-reload" text="🔄  Tải lại dữ liệu" />
            <Button fx:id="deleteButton" maxWidth="Infinity" mnemonicParsing="false" onAction="#clickToDeleteUser" styleClass="admin-btn-delete" text="🗑️  Xóa tài khoản" />

            <Region VBox.vgrow="ALWAYS" />
            <Separator style="-fx-opacity: 0.5; -fx-padding: 4 0 4 0;" />

            <Button fx:id="logOutAd" maxWidth="Infinity" mnemonicParsing="false" onAction="#logOut" styleClass="admin-btn-exit" text="🚪  Thoát" />
        </VBox>
    </right>

</BorderPane>
