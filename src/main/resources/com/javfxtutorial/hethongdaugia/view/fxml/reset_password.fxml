<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.paint.*?>
<?import javafx.scene.text.*?>

<VBox prefWidth="420.0" spacing="20.0" style="-fx-background-color: linear-gradient(to right, -sf-page-start, -sf-surface, -sf-page-start); -fx-border-color: linear-gradient(to right, -sf-page-start, -sf-surface, -sf-page-start); -fx-border-width: 2;" stylesheets="@../css/global.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javfxtutorial.hethongdaugia.client.controller.PasswordResetController">
   <padding>
      <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
   </padding>
   <children>
      <HBox prefHeight="100.0" prefWidth="388.0">
         <children>
            <ImageView fitHeight="100.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../../assets/Beta01.png" />
               </image>
            </ImageView>
            <Label alignment="CENTER" prefHeight="100.0" prefWidth="288.0" text="Đặt Lại Mật Khẩu">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
               <textFill>
                  <LinearGradient endX="1.0" endY="1.0">
                     <stops>
                        <Stop>
                           <color>
                              <Color green="0.31034475564956665" blue="1.0" />
                           </color>
                        </Stop>
                        <Stop offset="1.0">
                           <color>
                              <Color red="0.6166666746139526" blue="1.0" />
                           </color>
                        </Stop>
                     </stops>
                  </LinearGradient>
               </textFill>
            </Label>
         </children>
      </HBox>
      <GridPane hgap="15.0" vgap="15.0">
         <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" maxWidth="120.0" minWidth="10.0" prefWidth="100.0" />
            <ColumnConstraints hgrow="SOMETIMES" maxWidth="260.0" minWidth="10.0" prefWidth="250.0" />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints />
         </rowConstraints>
         <children>
            <Label fx:id="newdPW" style="-fx-font-weight: bold;" text="Mật khẩu mới:" />
            <TextField fx:id="txtNewPW" style="-fx-border-color: -sf-border; -fx-border-radius: 4; -fx-background-radius: 4; -fx-font-size: 12px;-fx-background-color: -sf-surface;" GridPane.columnIndex="1" />
            <Label fx:id="confirmPW" prefHeight="27.0" prefWidth="100.0" style="-fx-font-weight: bold;" text="Xác nhận lại:" GridPane.rowIndex="1" />
            <TextField fx:id="txtConfirmPW" style="-fx-border-color: -sf-border; -fx-border-radius: 4; -fx-background-radius: 4; -fx-font-size: 12px;-fx-background-color: -sf-surface;" GridPane.columnIndex="1" GridPane.rowIndex="1" />
         </children>
      </GridPane>
      <HBox alignment="CENTER_RIGHT" spacing="15.0">
         <VBox.margin>
            <Insets top="10.0" />
         </VBox.margin>
         <children>
            <Button fx:id="btnCancel" cancelButton="true" mnemonicParsing="false" prefWidth="90.0" style="-fx-background-color: -sf-neutral; -fx-text-fill: -sf-on-accent; -fx-font-weight: bold;" text="Hủy bỏ" />
            <Button fx:id="btnSave" defaultButton="true" mnemonicParsing="false" onAction="#updatePW" prefWidth="110.0" style="-fx-background-color: -sf-success; -fx-text-fill: -sf-on-accent; -fx-font-weight: bold;" text="Lưu thay đổi" />
         </children>
      </HBox>
   </children>
</VBox>
