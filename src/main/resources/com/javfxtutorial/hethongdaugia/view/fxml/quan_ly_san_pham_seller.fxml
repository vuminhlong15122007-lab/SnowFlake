<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.collections.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="720" prefWidth="1280.0" style="-fx-background-color: linear-gradient(to bottom, #e6f7ff, #ffffff);" stylesheets="@../css/global.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javfxtutorial.hethongdaugia.client.controller.SellerManagementController">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="55.0" prefWidth="737.0" spacing="15" style="-fx-background-color: linear-gradient(to right, #89CFF0, lavender); -fx-padding: 0 15;">

            <ImageView fitHeight="53.0" fitWidth="84.0" pickOnBounds="true" preserveRatio="true">
                <image>
                    <Image url="@../../assets/ClassicLogo.png" />
                </image>
            </ImageView>

            <Label style="-fx-font-size: 18px; -fx-text-fill: linear-gradient(to right, purple, #2f80ed); -fx-font-weight: bold;" text="SnowFox - Quản lý sản phẩm" />

            <Region HBox.hgrow="ALWAYS" />

            <Button fx:id="goMenu" onAction="#goMenu" style="-fx-background-color: linear-gradient(to right, #56ccf2, #2f80ed); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 15; -fx-padding: 5 15; -fx-font-size: 12px;" text="Trang chủ" />
        </HBox>
    </top>

    <center>
        <HBox fillHeight="true" spacing="10" style="-fx-padding: 10; -fx-background-color: transparent;">

            <VBox prefHeight="619.0" prefWidth="500.0" spacing="8" style="-fx-background-color: #ffffff; -fx-padding: 10; -fx-background-radius: 8; -fx-border-color: #b3c6ff; -fx-border-radius: 8;" HBox.hgrow="NEVER">

                <Label style="-fx-font-size: 14px; -fx-text-fill: #333366; -fx-font-weight: bold;" text="Danh sách sản phẩm" />

                <ListView fx:id="productList" prefHeight="508.0" prefWidth="203.0" VBox.vgrow="ALWAYS" />

                <HBox alignment="CENTER" spacing="10">
                    <Button onAction="#suaSp" prefWidth="70" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-font-size: 12px;" text="Sửa" />
                    <Button fx:id="deleteButton1" onAction="#deleteAuction" prefWidth="70" style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-font-size: 12px;" text="Xóa" />
                </HBox>
            </VBox>

            <VBox spacing="6" style="-fx-background-color: lavender; -fx-padding: 12; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 4, 0, 0, 1);" HBox.hgrow="ALWAYS">

                <Label style="-fx-font-size: 14px; -fx-text-fill: #4b0082; -fx-font-weight: bold;" text="Chi tiết sản phẩm" />

                <HBox alignment="CENTER_LEFT" prefHeight="121.0" prefWidth="440.0" spacing="10">
                    <ImageView fx:id="Image" fitHeight="246.0" fitWidth="192.0" pickOnBounds="true" preserveRatio="true">
                        <image>
                            <Image url="@../../assets/ClassicLogo.png" />
                        </image>
                    </ImageView>
                    <Button fx:id="btupImg" onAction="#clickToChooseImage" style="-fx-background-color: linear-gradient(to right, purple, #2f80ed); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-font-size: 11px; -fx-padding: 5 10;" text="Tải ảnh lên" />
                </HBox>

                <TextField fx:id="nameField" prefHeight="38.0" prefWidth="440.0" promptText="Tên sản phẩm" style="-fx-border-color: #b3c6ff; -fx-border-radius: 4; -fx-background-radius: 4; -fx-font-size: 12px; -fx-background-color: white;" />

                <TextArea fx:id="descriptionField" prefHeight="162.0" prefWidth="984.0" promptText="Mô tả sản phẩm" style="-fx-border-color: #b3c6ff; -fx-border-radius: 4; -fx-font-size: 12px; -fx-background-color: white; " wrapText="true" />

                <HBox prefHeight="34.0" prefWidth="440.0" spacing="8">
                    <TextField fx:id="priceField" prefHeight="27.0" prefWidth="200.0" promptText="Giá khởi điểm" style="-fx-border-color: #b3c6ff; -fx-border-radius: 4; -fx-background-radius: 4; -fx-font-size: 12px;-fx-background-color: white;" HBox.hgrow="ALWAYS" />

                    <TextField fx:id="tfstepPrice" prefHeight="27.0" prefWidth="200" promptText="Bước giá" style="-fx-border-color: #b3c6ff; -fx-border-radius: 4; -fx-background-radius: 4; -fx-font-size: 12px;-fx-background-color: white;" HBox.hgrow="ALWAYS" />
   
                   <ComboBox fx:id="categoryComboBox" prefHeight="27.0" prefWidth="190.0" promptText="Chọn phân loại" style="-fx-border-color: #b3c6ff; -fx-border-radius: 4; -fx-background-radius: 4; -fx-font-size: 12px;-fx-background-color: white;">
                       <items>
                           <FXCollections fx:factory="observableArrayList">
                        </FXCollections>
                       </items>
                   </ComboBox>
                </HBox>

                <HBox alignment="CENTER_LEFT" prefHeight="37.0" prefWidth="440.0" spacing="5">
                    <Label prefWidth="55" style="-fx-text-fill: #333366; -fx-font-weight: bold; -fx-font-size: 11px;" text="Bắt đầu:" />
                    <DatePicker fx:id="startDatePicker" prefWidth="110" promptText="Chọn ngày" style="-fx-font-size: 11px;" />
                    <Spinner fx:id="startHourSpinner" prefWidth="55" style="-fx-font-size: 11px;">
                        <valueFactory>
                            <SpinnerValueFactory.IntegerSpinnerValueFactory initialValue="12" max="23" min="0" />
                        </valueFactory>
                    </Spinner>
                    <Label style="-fx-font-size: 11px;" text="Giờ" />
                    <Spinner fx:id="startMinuteSpinner" prefWidth="55" style="-fx-font-size: 11px;">
                        <valueFactory>
                            <SpinnerValueFactory.IntegerSpinnerValueFactory initialValue="0" max="59" min="0" />
                        </valueFactory>
                    </Spinner>
                    <Label style="-fx-font-size: 11px;" text="Phút" />
                </HBox>

                <HBox alignment="CENTER_LEFT" prefHeight="40.0" prefWidth="440.0" spacing="5">
                    <Label prefWidth="55" style="-fx-text-fill: #333366; -fx-font-weight: bold; -fx-font-size: 11px;" text="Kết thúc:" />
                    <DatePicker fx:id="endDatePicker" prefWidth="110" promptText="Chọn ngày" style="-fx-font-size: 11px;" />
                    <Spinner fx:id="endHourSpinner" prefWidth="55" style="-fx-font-size: 11px;">
                        <valueFactory>
                            <SpinnerValueFactory.IntegerSpinnerValueFactory initialValue="12" max="23" min="0" />
                        </valueFactory>
                    </Spinner>
                    <Label style="-fx-font-size: 11px;" text="Giờ" />
                    <Spinner fx:id="endMinuteSpinner" prefWidth="55" style="-fx-font-size: 11px;">
                        <valueFactory>
                            <SpinnerValueFactory.IntegerSpinnerValueFactory initialValue="0" max="59" min="0" />
                        </valueFactory>
                    </Spinner>
                    <Label style="-fx-font-size: 11px;" text="Phút" />
                </HBox>

                <HBox alignment="CENTER">
                    <Button fx:id="saveButton" onAction="#luuSp" prefWidth="100" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 5 0; -fx-font-size: 12px;" text="Lưu" />
                </HBox>
            </VBox>

        </HBox>
    </center>

    <bottom>
        <HBox alignment="CENTER" style="-fx-background-color: #b3c6ff; -fx-padding: 5;">
            <Label style="-fx-text-fill: white; -fx-font-size: 11px;" text="© 2026 SnowFox - Studio SnowFlake" />
        </HBox>
    </bottom>

</BorderPane>
