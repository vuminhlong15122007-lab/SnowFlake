<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<StackPane id="loginPane" prefHeight="720.0" prefWidth="1280.0" stylesheets="@../css/global.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javfxtutorial.hethongdaugia.client.controller.LoginController">

    <children>
        <Pane style="-fx-background-color: linear-gradient(to right, -sf-page-start, -sf-surface, -sf-page-start);" />

        <AnchorPane maxHeight="556.0" maxWidth="985.0" prefHeight="556.0" prefWidth="985.0">
            <children>
                <VBox alignment="CENTER" layoutX="50.0" layoutY="92.0" prefHeight="164.0" prefWidth="330.0" spacing="14.0">
                    <children>
                        <HBox alignment="CENTER">
                            <children>
                                <ImageView fitHeight="108.0" fitWidth="108.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../../assets/Logo.png" />
                                    </image>
                                </ImageView>
                                <Label prefHeight="100.0" prefWidth="190.0" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: linear-gradient(to right, -sf-purple, -sf-accent);" text="  SnowFox" />
                            </children>
                        </HBox>
                        <Label alignment="CENTER" maxWidth="320.0" style="-fx-font-size: 18px; -fx-text-fill: -sf-accent; -fx-font-weight: bold;" text="Phát triển bởi Studio SnowFalke" wrapText="true" />
                    </children>
                </VBox>

                <VBox alignment="CENTER" layoutX="550.0" layoutY="33.0" prefHeight="496.0" prefWidth="358.0" spacing="15.0" style="-fx-background-color: -sf-panel; -fx-background-radius: 25; -fx-padding: 30; -fx-effect: dropshadow(gaussian, -sf-shadow-neutral, 25, 0, 0, 10); -fx-border-color: -sf-border; -fx-border-radius: 25;">
                    <children>
                        <Label style="-fx-font-size: 25px; -fx-font-weight: bold; -fx-text-fill: linear-gradient(to right, -sf-purple, -sf-accent);" text="Đăng nhập" />

                        <TextField fx:id="Username" prefHeight="40.0" promptText="Tên đăng nhập" style="-fx-background-color: -sf-surface; -fx-background-radius: 10; -fx-border-color: -sf-border; -fx-border-radius: 10; -fx-padding: 9;" />
                        <StackPane maxWidth="355.0" prefHeight="35.0">
                            <PasswordField fx:id="Password" prefHeight="35.0" prefWidth="355.0" promptText="Mật khẩu" style="-fx-background-color: -sf-surface; -fx-background-radius: 12; -fx-border-color: -sf-border; -fx-border-radius: 12; -fx-padding: 8;" />
                            <TextField fx:id="PasswordVisible" prefHeight="35.0" prefWidth="355.0" promptText="Mật khẩu" style="-fx-background-color: -sf-surface; -fx-background-radius: 12; -fx-border-color: -sf-border; -fx-border-radius: 12; -fx-padding: 8;" visible="false" />
                            <Button fx:id="togglePassword" onAction="#togglePasswordVisibility" prefHeight="24.0" prefWidth="30.0" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-font-size: 14px; -fx-padding: 0 8 0 0;" text="👁" StackPane.alignment="CENTER_RIGHT" />
                        </StackPane>

                        <Button fx:id="login" onAction="#clickLogin" prefHeight="40.0" prefWidth="220.0" style="-fx-background-radius: 20; -fx-background-color: linear-gradient(to right, -sf-accent-2, -sf-accent); -fx-text-fill: -sf-on-accent; -fx-font-weight: bold; -fx-cursor: hand;" text="Đăng nhập" />

                        <Button id="sign_in" fx:id="sign_in" onAction="#clickCreateAccount" prefHeight="35.0" prefWidth="220.0" style="-fx-background-radius: 20; -fx-background-color: transparent; -fx-border-color: -sf-accent; -fx-border-radius: 20; -fx-text-fill: -sf-accent; -fx-font-weight: bold; -fx-cursor: hand;" text="Tạo tài khoản mới" />

                        <Label fx:id="message" alignment="CENTER" prefHeight="18.0" prefWidth="272.0" style="-fx-text-fill: -sf-danger;" textAlignment="CENTER" />
                    </children>
                </VBox>
            </children>
        </AnchorPane>
    </children>
</StackPane>
