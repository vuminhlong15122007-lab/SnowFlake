<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="180.0" prefWidth="780.0" style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-radius: 12; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 8, 0, 0, 2);" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javfxtutorial.hethongdaugia.client.controller.AuctionSessionController">

    <HBox alignment="CENTER_LEFT" spacing="20.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0">

        <!-- ==================== ẢNH SẢN PHẨM ==================== -->
        <StackPane prefHeight="150.0" prefWidth="150.0" style="-fx-background-color: #f8f9fa; -fx-background-radius: 12;">
            <ImageView fx:id="productImage" fitHeight="120.0" fitWidth="120.0" pickOnBounds="true" preserveRatio="true" />
        </StackPane>

        <!-- ==================== THÔNG TIN CHÍNH ==================== -->
        <VBox prefHeight="147.0" prefWidth="245.0" spacing="10.0" HBox.hgrow="ALWAYS">
         <Label fx:id="lbCategory" text="Loại sản phẩm" />

            <!-- Tên sản phẩm -->
            <Label fx:id="lbProductName" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="MacBook Pro M3" />

            <!-- Người bán -->
            <HBox spacing="5.0">
                <Label prefHeight="20.0" prefWidth="94.0" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;" text="Người bán:" />
                <Label fx:id="lbSellerName" prefHeight="20.0" prefWidth="208.0" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;" text="TechStore_HN" />
            </HBox>

            <!-- Giá + Thời gian -->
            <HBox alignment="CENTER_LEFT" prefHeight="34.0" prefWidth="275.0" spacing="30.0">
            <Label prefHeight="20.0" prefWidth="88.0" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;" text="Giá hiện tại:" />
                 <Label fx:id="lbPrice" prefHeight="27.0" prefWidth="173.0" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #e74c3c;" text="45,000,000 VND" />
            </HBox>

            <!-- Thông tin bổ sung (dành cho ĐÃ KẾT THÚC hoặc SẮP DIỄN RA) -->
            <HBox fx:id="extraInfoBox" managed="false" spacing="5.0" visible="false">
                <Label fx:id="extraInfoLabel" style="-fx-font-size: 13px; -fx-text-fill: #27ae60; -fx-font-weight: bold;" text="Người thắng: user_abc" />
            </HBox>
        </VBox>
      <Pane prefHeight="147.0" prefWidth="121.0">
         <children>
            <VBox layoutY="40.0" prefHeight="47.0" prefWidth="121.0" spacing="3.0">
               <children>
                  <Pane prefHeight="200.0" prefWidth="200.0" />
               </children>
            </VBox>
         </children>
      </Pane>

        <!-- ==================== NÚT HÀNH ĐỘNG ==================== -->
        <VBox alignment="CENTER" prefWidth="140.0" spacing="10.0">
            <Button fx:id="actionButton" prefHeight="40.0" prefWidth="140.0" style="-fx-background-color: linear-gradient(to right, #56ccf2, #2f80ed); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-background-radius: 25; -fx-cursor: hand;" text="THAM GIA" />
        </VBox>

    </HBox>
      <!-- Tag trạng thái nổi trên ảnh -->
      <Label fx:id="statusBadge" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 10px; -fx-font-weight: bold; -fx-padding: 4 10; -fx-background-radius: 8;" text="ĐANG DIỄN RA" />
</AnchorPane>
