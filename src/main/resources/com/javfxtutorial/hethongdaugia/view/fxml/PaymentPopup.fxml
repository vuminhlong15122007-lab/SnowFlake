<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="12.0" style="-fx-background-color: white; -fx-padding: 25; -fx-border-color: #2f80ed; -fx-border-width: 2; -fx-border-radius: 12; -fx-background-radius: 12;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javfxtutorial.hethongdaugia.client.controller.PaymentPopupController">

    <!-- Tiêu đề -->
    <Label style="-fx-font-weight: bold; -fx-font-size: 18; -fx-text-fill: #2c3e50;" text="💳  THANH TOÁN ĐẤU GIÁ" />

    <!-- Ảnh sản phẩm + tên -->
    <HBox alignment="CENTER" spacing="15">
        <StackPane style="-fx-background-color: #f0f4f8; -fx-background-radius: 10; -fx-padding: 8;">
            <ImageView fx:id="productImageView" fitHeight="100.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="true" />
        </StackPane>
        <VBox alignment="CENTER_LEFT" spacing="6">
            <Label fx:id="lbProductName" maxWidth="180" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Tên sản phẩm" wrapText="true" />
            <Label fx:id="lbAuctionId" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;" text="Mã phiên: #0" />
            <HBox alignment="CENTER_LEFT" spacing="5">
                <Label style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d;" text="Số tiền:" />
                <Label fx:id="lbWinningPrice" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #e74c3c;" text="0 VND" />
            </HBox>
        </VBox>
    </HBox>

    <Separator />

    <!-- QR Code -->
    <Label style="-fx-font-weight: bold; -fx-font-size: 13; -fx-text-fill: #555;" text="QUÉT MÃ QR ĐỂ THANH TOÁN" />
    <ImageView fx:id="qrImageView" fitHeight="220.0" fitWidth="220.0" pickOnBounds="true" preserveRatio="true">
      <image>
         <Image url="@../../assets/anh_qr_popup.png" />
      </image></ImageView>
    <Label style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;" text="Nội dung: Thanh toán đấu giá SnowFox" />

    <!-- Nút đóng -->
    <Button mnemonicParsing="false" onAction="#closePopup" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 20; -fx-padding: 8 30;" text="Xác nhận đã thanh toán" />
</VBox>
