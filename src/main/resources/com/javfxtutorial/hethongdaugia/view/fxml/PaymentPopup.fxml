<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="12.0" style="-fx-padding: 25;" styleClass="sf-popup" stylesheets="@../css/global.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javfxtutorial.hethongdaugia.client.controller.PaymentPopupController">

    <!-- Tiêu đề -->
    <Label styleClass="sf-section-title" text="💳  THANH TOÁN ĐẤU GIÁ" />

    <!-- Ảnh sản phẩm + tên -->
    <HBox alignment="CENTER" spacing="15">
        <StackPane style="-fx-background-color: -sf-surface-soft; -fx-background-radius: 12; -fx-border-color: -sf-border-soft; -fx-border-radius: 12; -fx-padding: 8;">
            <ImageView fx:id="productImageView" fitHeight="100.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="true" />
        </StackPane>
        <VBox alignment="CENTER_LEFT" spacing="6">
            <Label fx:id="lbProductName" maxWidth="180" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: -sf-heading;" text="Tên sản phẩm" wrapText="true" />
            <Label fx:id="lbAuctionId" style="-fx-font-size: 12px; -fx-text-fill: -sf-muted;" text="Mã phiên: #0" />
            <HBox alignment="CENTER_LEFT" spacing="5">
                <Label style="-fx-font-size: 13px; -fx-text-fill: -sf-muted;" text="Số tiền:" />
                <Label fx:id="lbWinningPrice" style="-fx-font-size: 15px;" styleClass="sf-price-text" text="0 VND" />
            </HBox>
        </VBox>
    </HBox>

    <Separator />

    <!-- Phần thanh toán (hiện khi còn thời gian) -->
    <VBox fx:id="paymentSection" alignment="CENTER" spacing="10">
        <Label style="-fx-font-weight: bold; -fx-font-size: 13; -fx-text-fill: -sf-text;" text="QUÉT MÃ QR ĐỂ THANH TOÁN TRƯỚC " />
        <Label fx:id="lbTime" style="-fx-font-weight: bold; -fx-font-size: 13; -fx-text-fill: -sf-danger;" text="TIME" />
        <ImageView fx:id="qrImageView" fitHeight="220.0" fitWidth="220.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@../../assets/anh_qr_popup.png" />
            </image>
        </ImageView>
        <Label style="-fx-font-size: 12px; -fx-text-fill: -sf-muted;" text="Nội dung: Thanh toán đấu giá SnowFox" />
        <Button fx:id="onIdentify" mnemonicParsing="false" onAction="#confirmPayment" style="-fx-padding: 8 30;" styleClass="sf-btn-danger" text="Xác nhận đã thanh toán" />
    </VBox>

    <!-- Phần cảnh báo kiện (hiện khi hết 24h, mặc định ẩn) -->
    <VBox fx:id="lawsuitSection" alignment="CENTER" spacing="14" visible="false" managed="false"
          style="-fx-background-color: -sf-danger-soft;
                 -fx-background-radius: 14;
                 -fx-border-color: -sf-danger-2;
                 -fx-border-radius: 14;
                 -fx-border-width: 1.5;
                 -fx-padding: 28;
                 -fx-effect: dropshadow(gaussian, rgba(215,46,91,0.18), 16, 0.2, 0, 4);">

        <!-- Icon cảnh báo -->
        <Label text=" CẢNH BÁO "
               style="-fx-font-size: 38px;
                      -fx-text-fill: -sf-on-accent;
                      -fx-background-color: linear-gradient(to bottom right, -sf-danger-2, -sf-danger);
                      -fx-background-radius: 50;
                      -fx-padding: 6 16;" />

        <!-- Tiêu đề chính -->
        <Label text="BẠN SẼ BỊ KIỆN !!!"
               style="-fx-font-size: 20px;
                      -fx-font-weight: bold;
                      -fx-text-fill: -sf-danger;" />

        <!-- Đường kẻ -->
        <Separator style="-fx-background-color: -sf-danger-2; -fx-opacity: 0.4;" maxWidth="200" />

        <!-- Mô tả -->
        <Label text="Thời gian chờ thanh toán đã hết. Theo điều Luật năm 2016, sửa đổi bổ sung năm 2024 về luật Đấu giá tài sản,bộ phận pháp lý chúng tôi sẽ sớm liên hệ với bạn."
               style="-fx-font-size: 12px;
                      -fx-text-fill: -sf-muted;
                      -fx-text-alignment: center;"
               wrapText="true" maxWidth="240" />
    </VBox>

</VBox>
