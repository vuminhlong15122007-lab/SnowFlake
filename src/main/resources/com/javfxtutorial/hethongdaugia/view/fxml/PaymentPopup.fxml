<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="12.0" style="-fx-background-color: -sf-surface; -fx-padding: 25; -fx-border-color: -sf-accent; -fx-border-width: 2; -fx-border-radius: 12; -fx-background-radius: 12;" stylesheets="@../css/global.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javfxtutorial.hethongdaugia.client.controller.PaymentPopupController">

    <!-- Tiêu đề -->
    <Label style="-fx-font-weight: bold; -fx-font-size: 18; -fx-text-fill: -sf-heading;" text="💳  THANH TOÁN ĐẤU GIÁ" />

    <!-- Ảnh sản phẩm + tên -->
    <HBox alignment="CENTER" spacing="15">
        <StackPane style="-fx-background-color: -sf-surface-muted; -fx-background-radius: 10; -fx-padding: 8;">
            <ImageView fx:id="productImageView" fitHeight="100.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="true" />
        </StackPane>
        <VBox alignment="CENTER_LEFT" spacing="6">
            <Label fx:id="lbProductName" maxWidth="180" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: -sf-heading;" text="Tên sản phẩm" wrapText="true" />
            <Label fx:id="lbAuctionId" style="-fx-font-size: 12px; -fx-text-fill: -sf-subtle;" text="Mã phiên: #0" />
            <HBox alignment="CENTER_LEFT" spacing="5">
                <Label style="-fx-font-size: 13px; -fx-text-fill: -sf-subtle;" text="Số tiền:" />
                <Label fx:id="lbWinningPrice" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: -sf-danger;" text="0 VND" />
            </HBox>
        </VBox>
    </HBox>

    <Separator />

    <!-- QR Code -->
    <Label style="-fx-font-weight: bold; -fx-font-size: 13; -fx-text-fill: #555;" text="QUÉT MÃ QR ĐỂ THANH TOÁN TRƯỚC " />
   <Label fx:id="lbTime" style="-fx-font-weight: bold; -fx-font-size: 13; -fx-text-fill: #555;" text="TIME" />
    <Label style="-fx-font-weight: bold; -fx-font-size: 13; -fx-text-fill: -sf-muted;" text="QUÉT MÃ QR ĐỂ THANH TOÁN" />
    <ImageView fx:id="qrImageView" fitHeight="220.0" fitWidth="220.0" pickOnBounds="true" preserveRatio="true">
      <image>
         <Image url="@../../assets/anh_qr_popup.png" />
      </image></ImageView>
    <Label style="-fx-font-size: 12px; -fx-text-fill: -sf-subtle;" text="Nội dung: Thanh toán đấu giá SnowFox" />

    <!-- Nút đóng -->
    <Button fx:id="onIdentify" mnemonicParsing="false" onAction="#confirmPayment" style="-fx-background-color: -sf-danger; -fx-text-fill: -sf-on-accent; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 20; -fx-padding: 8 30;" text="Xác nhận đã thanh toán" />
</VBox>
