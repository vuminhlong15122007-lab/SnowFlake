<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<StackPane prefHeight="720.0" prefWidth="1280.0" stylesheets="@../css/global.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javfxtutorial.hethongdaugia.client.controller.RegisterController">

    <children>
        <Pane styleClass="sf-auth-backdrop" />

        <AnchorPane maxHeight="532.0" maxWidth="943.0" prefHeight="532.0" prefWidth="943.0">
            <children>
                <VBox alignment="CENTER" layoutX="24.0" layoutY="90.0" prefHeight="214.0" prefWidth="408.0" spacing="14.0" styleClass="sf-auth-brand">
                    <children>
                        <HBox alignment="CENTER" prefHeight="102.0" prefWidth="391.0">
                            <children>
                                <ImageView fitHeight="108.0" fitWidth="108.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../../assets/Logo.png" />
                                    </image>
                                </ImageView>
                                <Label prefHeight="100.0" prefWidth="176.0" style="-fx-font-size: 36px;" styleClass="sf-title" text="SnowFox" />
                            </children>
                        </HBox>
                        <Label alignment="CENTER" maxWidth="419.0" prefHeight="50.0" prefWidth="419.0" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: -sf-accent;" text="Kỷ nguyên vươn mình cùng SnowFox" wrapText="true" />
                    </children>
                </VBox>

                <VBox fx:id="rootVBox" alignment="CENTER" layoutX="522.0" layoutY="47.0" prefHeight="456.0" prefWidth="389.0" spacing="10.0" styleClass="sf-auth-panel">
                    <children>
                        <Label style="-fx-font-size: 23px;" styleClass="sf-section-title" text="Đăng ký tài khoản" />

                        <TextField fx:id="Username" prefHeight="35.0" promptText="Tên người dùng" styleClass="sf-auth-field" />
                        <TextField fx:id="Email" prefHeight="35.0" promptText="Email" styleClass="sf-auth-field" />
                        <TextField fx:id="PhoneNumber" prefHeight="35.0" promptText="Số điện thoại" styleClass="sf-auth-field" />

                        <!-- Ô mật khẩu + nút hiện/ẩn -->
                        <StackPane maxWidth="355.0" prefHeight="35.0">
                            <PasswordField fx:id="Password" prefHeight="35.0" prefWidth="355.0" promptText="Mật khẩu" styleClass="sf-auth-field" />
                            <TextField fx:id="PasswordVisible" prefHeight="35.0" prefWidth="355.0" promptText="Mật khẩu" styleClass="sf-auth-field" visible="false" />
                            <Button fx:id="togglePassword" onAction="#togglePasswordVisibility" prefHeight="24.0" prefWidth="30.0" styleClass="sf-icon-button" text="👁" StackPane.alignment="CENTER_RIGHT" />
                        </StackPane>

                        <!-- Ô xác nhận mật khẩu + nút hiện/ẩn -->
                        <StackPane maxWidth="355.0" prefHeight="35.0">
                            <PasswordField fx:id="Confirm_Password" prefHeight="35.0" prefWidth="355.0" promptText="Xác nhận mật khẩu" styleClass="sf-auth-field" />
                            <TextField fx:id="ConfirmPasswordVisible" prefHeight="35.0" prefWidth="355.0" promptText="Xác nhận mật khẩu" styleClass="sf-auth-field" visible="false" />
                            <Button fx:id="toggleConfirmPassword" onAction="#toggleConfirmPasswordVisibility" prefHeight="24.0" prefWidth="30.0" styleClass="sf-icon-button" text="👁" StackPane.alignment="CENTER_RIGHT" />
                        </StackPane>

                        <!-- Điều khoản -->
                        <HBox alignment="CENTER" spacing="6.0">
                            <CheckBox fx:id="agreeCheckBox" disable="true" style="-fx-text-fill: -sf-accent; -fx-font-weight: bold;" />
                            <Hyperlink onAction="#showTerms" style="-fx-text-fill: -sf-accent; -fx-font-weight: bold; -fx-padding: 0;" text="Tôi đồng ý với điều khoản sử dụng" />
                        </HBox>

                        <Button fx:id="Sign_up" onAction="#clickSignUp" prefHeight="38.0" prefWidth="200.0" styleClass="sf-btn-primary" text="ĐĂNG KÝ" />

                        <Button fx:id="backToLogin" onAction="#clickBackToLogin" prefHeight="30.0" prefWidth="200.0" styleClass="sf-link-button" text="Quay lại đăng nhập" />

                        <Label fx:id="message" alignment="CENTER" prefHeight="18.0" prefWidth="262.0" style="-fx-text-fill: -sf-danger;" textAlignment="CENTER" />
                    </children>
                </VBox>
            </children>
        </AnchorPane>

        <fx:include fx:id="notificationToast" source="NotificationToast.fxml" />
    </children>
</StackPane>
