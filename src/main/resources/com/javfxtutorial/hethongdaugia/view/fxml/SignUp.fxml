<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<StackPane prefHeight="720.0" prefWidth="1280.0" stylesheets="@../css/global.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javfxtutorial.hethongdaugia.client.controller.RegisterController">

    <children>
        <Pane style="-fx-background-color: linear-gradient(to right, #e0f7ff, #ffffff, #d6f0ff);" />

        <!-- Popup điều khoản (ẩn mặc định) -->
        <StackPane fx:id="termsOverlay" visible="false" style="-fx-background-color: rgba(0,0,0,0.45);">
            <VBox alignment="CENTER" maxWidth="520.0" maxHeight="420.0" spacing="12.0"
                  style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 20, 0, 0, 6);">
                <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2f80ed;" text="📋 Điều khoản sử dụng SnowFox" />
                <Separator />
                <ScrollPane prefHeight="260.0" fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;">
                    <content>
                        <Label wrapText="true" style="-fx-font-size: 13px; -fx-text-fill: #333;" text="1. Người dùng phải đủ 18 tuổi trở lên để đăng ký và tham gia đấu giá trên hệ thống SnowFox.&#10;&#10;2. Thông tin cá nhân cung cấp khi đăng ký phải chính xác, trung thực. Người dùng chịu hoàn toàn trách nhiệm với thông tin đã khai báo.&#10;&#10;3. Tài khoản chỉ được sử dụng bởi chính chủ sở hữu. Nghiêm cấm chia sẻ, cho thuê hoặc bán tài khoản cho người khác.&#10;&#10;4. Khi tham gia đấu giá, mỗi lần đặt giá được coi là một cam kết mua hàng. Người thắng cuộc có nghĩa vụ hoàn tất giao dịch.&#10;&#10;5. Nghiêm cấm các hành vi gian lận, thông đồng, hoặc cố tình thao túng kết quả đấu giá. Vi phạm sẽ bị khóa tài khoản vĩnh viễn.&#10;&#10;6. SnowFox bảo lưu quyền từ chối hoặc hủy bỏ bất kỳ phiên đấu giá nào nếu phát hiện dấu hiệu vi phạm.&#10;&#10;7. Thông tin thanh toán và giao dịch được bảo mật theo tiêu chuẩn bảo mật hiện hành.&#10;&#10;8. Bằng cách đăng ký, bạn đồng ý với toàn bộ các điều khoản và điều kiện nêu trên." />
                    </content>
                </ScrollPane>
                <Button onAction="#closeTerms" prefWidth="150.0" prefHeight="36.0"
                        style="-fx-background-color: linear-gradient(to right, #56ccf2, #2f80ed); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="Đã hiểu, Đóng" />
            </VBox>
        </StackPane>

        <AnchorPane maxHeight="532.0" maxWidth="943.0" prefHeight="532.0" prefWidth="943.0">
            <children>
                <VBox layoutX="50.0" layoutY="112.0" prefHeight="172.0" prefWidth="340.0" spacing="14.0">
                    <children>
                        <HBox alignment="CENTER" prefHeight="108.0" prefWidth="286.0">
                            <children>
                                <ImageView fitHeight="108.0" fitWidth="108.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../../assets/Logo.png" />
                                    </image>
                                </ImageView>
                                <Label prefHeight="100.0" prefWidth="176.0" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: linear-gradient(to right, purple, #2f80ed);" text="SnowFox" />
                            </children>
                        </HBox>
                        <Label maxWidth="355.0" prefHeight="50.0" prefWidth="355.0" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2f80ed;" text="Kỷ nguyên vươn mình cùng SnowFox" wrapText="true" />
                    </children>
                </VBox>

                <VBox fx:id="rootVBox" alignment="CENTER" layoutX="522.0" layoutY="47.0" prefHeight="456.0" prefWidth="389.0" spacing="10.0" style="-fx-background-color: rgba(255,255,255,0.72); -fx-background-radius: 25; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.18), 25, 0, 0, 10); -fx-border-color: #b3c6ff; -fx-border-radius: 25;">
                    <children>
                        <Label style="-fx-font-size: 23px; -fx-font-weight: bold; -fx-text-fill: linear-gradient(to right, purple, #2f80ed);" text="Đăng ký tài khoản" />

                        <TextField fx:id="Username" prefHeight="35.0" promptText="Tên người dùng" style="-fx-pref-width: 200; -fx-background-color: #ffffff; -fx-background-radius: 12; -fx-border-color: #b3c6ff; -fx-border-radius: 12; -fx-padding: 8;" />
                        <TextField fx:id="Email" prefHeight="35.0" promptText="Email" style="-fx-pref-width: 200; -fx-background-color: #ffffff; -fx-background-radius: 12; -fx-border-color: #b3c6ff; -fx-border-radius: 12; -fx-padding: 8;" />
                        <TextField fx:id="PhoneNumber" prefHeight="35.0" promptText="Số điện thoại" style="-fx-pref-width: 200; -fx-background-color: #ffffff; -fx-background-radius: 12; -fx-border-color: #b3c6ff; -fx-border-radius: 12; -fx-padding: 8;" />

                        <!-- Ô mật khẩu + nút hiện/ẩn -->
                        <StackPane prefHeight="35.0" maxWidth="355.0">
                            <PasswordField fx:id="Password" prefHeight="35.0" prefWidth="355.0" promptText="Mật khẩu" style="-fx-background-color: #ffffff; -fx-background-radius: 12; -fx-border-color: #b3c6ff; -fx-border-radius: 12; -fx-padding: 8;" />
                            <TextField fx:id="PasswordVisible" prefHeight="35.0" prefWidth="355.0" promptText="Mật khẩu" visible="false" style="-fx-background-color: #ffffff; -fx-background-radius: 12; -fx-border-color: #b3c6ff; -fx-border-radius: 12; -fx-padding: 8;" />
                            <Button fx:id="togglePassword" onAction="#togglePasswordVisibility" prefWidth="30.0" prefHeight="24.0"
                                    text="👁" StackPane.alignment="CENTER_RIGHT"
                                    style="-fx-background-color: transparent; -fx-cursor: hand; -fx-font-size: 14px; -fx-padding: 0 8 0 0;" />
                        </StackPane>

                        <!-- Ô xác nhận mật khẩu + nút hiện/ẩn -->
                        <StackPane prefHeight="35.0" maxWidth="355.0">
                            <PasswordField fx:id="Confirm_Password" prefHeight="35.0" prefWidth="355.0" promptText="Xác nhận mật khẩu" style="-fx-background-color: #ffffff; -fx-background-radius: 12; -fx-border-color: #b3c6ff; -fx-border-radius: 12; -fx-padding: 8;" />
                            <TextField fx:id="ConfirmPasswordVisible" prefHeight="35.0" prefWidth="355.0" promptText="Xác nhận mật khẩu" visible="false" style="-fx-background-color: #ffffff; -fx-background-radius: 12; -fx-border-color: #b3c6ff; -fx-border-radius: 12; -fx-padding: 8;" />
                            <Button fx:id="toggleConfirmPassword" onAction="#toggleConfirmPasswordVisibility" prefWidth="30.0" prefHeight="24.0"
                                    text="👁" StackPane.alignment="CENTER_RIGHT"
                                    style="-fx-background-color: transparent; -fx-cursor: hand; -fx-font-size: 14px; -fx-padding: 0 8 0 0;" />
                        </StackPane>

                        <!-- Điều khoản -->
                        <HBox alignment="CENTER_LEFT" spacing="6.0">
                            <CheckBox fx:id="agreeCheckBox" style="-fx-text-fill: #4e7ea8; -fx-font-weight: bold;" text="Tôi đồng ý với " />
                            <Hyperlink onAction="#showTerms" style="-fx-text-fill: #2f80ed; -fx-font-weight: bold; -fx-padding: 0;" text="điều khoản sử dụng" />
                        </HBox>

                        <Button fx:id="Sign_up" onAction="#clickSignUp" prefHeight="38.0" prefWidth="200.0" style="-fx-background-radius: 20; -fx-background-color: linear-gradient(to right, #56ccf2, #2f80ed); -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="ĐĂNG KÝ" />

                        <Button fx:id="backToLogin" onAction="#clickBackToLogin" prefHeight="30.0" prefWidth="200.0" style="-fx-background-color: transparent; -fx-text-fill: #2f80ed; -fx-font-weight: bold; -fx-cursor: hand;" text="Quay lại đăng nhập" />

                        <Label fx:id="message" alignment="CENTER" prefHeight="18.0" prefWidth="262.0" textAlignment="CENTER" textFill="#fc0000" />
                    </children>
                </VBox>
            </children>
        </AnchorPane>
    </children>
</StackPane>
