<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<StackPane prefHeight="720.0" prefWidth="1280.0" stylesheets="@../css/global.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javfxtutorial.hethongdaugia.client.controller.RegisterController">

    <children>
        <Pane style="-fx-background-color: linear-gradient(to right, -sf-page-start, -sf-surface, -sf-page-start);" />

        <AnchorPane maxHeight="532.0" maxWidth="943.0" prefHeight="532.0" prefWidth="943.0">
            <children>
                <VBox layoutX="50.0" layoutY="112.0" prefHeight="172.0" prefWidth="355.0" spacing="14.0">
                    <children>
                        <HBox alignment="CENTER" prefHeight="108.0" prefWidth="286.0">
                            <children>
                                <ImageView fitHeight="108.0" fitWidth="108.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../../assets/Logo.png" />
                                    </image>
                                </ImageView>
                                <Label prefHeight="100.0" prefWidth="176.0" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: linear-gradient(to right, -sf-purple, -sf-accent);" text="SnowFox" />
                            </children>
                        </HBox>
                        <Label maxWidth="419.0" prefHeight="50.0" prefWidth="419.0" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: -sf-accent;" text="Kỷ nguyên vươn mình cùng SnowFox" wrapText="true" />
                    </children>
                </VBox>

                <VBox fx:id="rootVBox" alignment="CENTER" layoutX="522.0" layoutY="47.0" prefHeight="456.0" prefWidth="389.0" spacing="10.0" style="-fx-background-color: -sf-panel; -fx-background-radius: 25; -fx-padding: 20; -fx-effect: dropshadow(gaussian, -sf-shadow-neutral, 25, 0, 0, 10); -fx-border-color: -sf-border; -fx-border-radius: 25;">
                    <children>
                        <Label style="-fx-font-size: 23px; -fx-font-weight: bold; -fx-text-fill: linear-gradient(to right, -sf-purple, -sf-accent);" text="Đăng ký tài khoản" />

                        <TextField fx:id="Username" prefHeight="35.0" promptText="Tên người dùng" style="-fx-pref-width: 200; -fx-background-color: -sf-surface; -fx-background-radius: 12; -fx-border-color: -sf-border; -fx-border-radius: 12; -fx-padding: 8;" />
                        <TextField fx:id="Email" prefHeight="35.0" promptText="Email" style="-fx-pref-width: 200; -fx-background-color: -sf-surface; -fx-background-radius: 12; -fx-border-color: -sf-border; -fx-border-radius: 12; -fx-padding: 8;" />
                        <TextField fx:id="PhoneNumber" prefHeight="35.0" promptText="Số điện thoại" style="-fx-pref-width: 200; -fx-background-color: -sf-surface; -fx-background-radius: 12; -fx-border-color: -sf-border; -fx-border-radius: 12; -fx-padding: 8;" />

                        <!-- Ô mật khẩu + nút hiện/ẩn -->
                        <StackPane maxWidth="355.0" prefHeight="35.0">
                            <PasswordField fx:id="Password" prefHeight="35.0" prefWidth="355.0" promptText="Mật khẩu" style="-fx-background-color: -sf-surface; -fx-background-radius: 12; -fx-border-color: -sf-border; -fx-border-radius: 12; -fx-padding: 8;" />
                            <TextField fx:id="PasswordVisible" prefHeight="35.0" prefWidth="355.0" promptText="Mật khẩu" style="-fx-background-color: -sf-surface; -fx-background-radius: 12; -fx-border-color: -sf-border; -fx-border-radius: 12; -fx-padding: 8;" visible="false" />
                            <Button fx:id="togglePassword" onAction="#togglePasswordVisibility" prefHeight="24.0" prefWidth="30.0" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-font-size: 14px; -fx-padding: 0 8 0 0;" text="👁" StackPane.alignment="CENTER_RIGHT" />
                        </StackPane>

                        <!-- Ô xác nhận mật khẩu + nút hiện/ẩn -->
                        <StackPane maxWidth="355.0" prefHeight="35.0">
                            <PasswordField fx:id="Confirm_Password" prefHeight="35.0" prefWidth="355.0" promptText="Xác nhận mật khẩu" style="-fx-background-color: -sf-surface; -fx-background-radius: 12; -fx-border-color: -sf-border; -fx-border-radius: 12; -fx-padding: 8;" />
                            <TextField fx:id="ConfirmPasswordVisible" prefHeight="35.0" prefWidth="355.0" promptText="Xác nhận mật khẩu" style="-fx-background-color: -sf-surface; -fx-background-radius: 12; -fx-border-color: -sf-border; -fx-border-radius: 12; -fx-padding: 8;" visible="false" />
                            <Button fx:id="toggleConfirmPassword" onAction="#toggleConfirmPasswordVisibility" prefHeight="24.0" prefWidth="30.0" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-font-size: 14px; -fx-padding: 0 8 0 0;" text="👁" StackPane.alignment="CENTER_RIGHT" />
                        </StackPane>

                        <!-- Điều khoản -->
                        <HBox alignment="CENTER" spacing="6.0">
                            <CheckBox fx:id="agreeCheckBox" disable="true" style="-fx-text-fill: -sf-accent; -fx-font-weight: bold;" />
                            <Hyperlink onAction="#showTerms" style="-fx-text-fill: -sf-accent; -fx-font-weight: bold; -fx-padding: 0;" text="Tôi đồng ý với điều khoản sử dụng" />
                        </HBox>

                        <Button fx:id="Sign_up" onAction="#clickSignUp" prefHeight="38.0" prefWidth="200.0" style="-fx-background-radius: 20; -fx-background-color: linear-gradient(to right, -sf-accent-2, -sf-accent); -fx-text-fill: -sf-on-accent; -fx-font-weight: bold; -fx-cursor: hand;" text="ĐĂNG KÝ" />

                        <Button fx:id="backToLogin" onAction="#clickBackToLogin" prefHeight="30.0" prefWidth="200.0" style="-fx-background-color: transparent; -fx-text-fill: -sf-accent; -fx-font-weight: bold; -fx-cursor: hand;" text="Quay lại đăng nhập" />

                        <Label fx:id="message" alignment="CENTER" prefHeight="18.0" prefWidth="262.0" style="-fx-text-fill: -sf-danger;" textAlignment="CENTER" />
                    </children>
                </VBox>
            </children>
        </AnchorPane>
    </children>
</StackPane>
