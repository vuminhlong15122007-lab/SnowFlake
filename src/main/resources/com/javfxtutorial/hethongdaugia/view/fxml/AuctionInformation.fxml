<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: #f0f8ff;" stylesheets="@../css/global.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javfxtutorial.hethongdaugia.client.controller.ProductDisplayController">

    <!-- ==================== HEADER ==================== -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="60.0" style="-fx-background-color: linear-gradient(to right, #89CFF0,lavender); -fx-padding: 0 20;">
            <ImageView fitHeight="45.0" fitWidth="45.0" pickOnBounds="true" preserveRatio="true">
                <image><Image url="@../../assets/Logo.png" /></image>
            </ImageView>
            <Label style="-fx-text-fill: linear-gradient(to right, #6A11CB, #2575FC); -fx-font-size: 18px; -fx-font-weight: bold; -fx-padding: 0 0 0 10;" text="SnowFox - Chi tiết sản phẩm" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnMenu" mnemonicParsing="false" onAction="#QuaylaiMenu" prefHeight="36.0" prefWidth="155.0" style="-fx-background-color: linear-gradient(to right, #56ccf2, #2f80ed); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 15;" text="Quay lại" />
        </HBox>
    </top>

    <!-- ==================== NỘI DUNG CHÍNH ==================== -->
    <center>
        <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent;">
            <HBox spacing="20" style="-fx-padding: 20;">

                <!-- ========== BÊN TRÁI: ẢNH + GIÁ + ĐỒNG HỒ ========== -->
                <VBox prefWidth="450" spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 15; -fx-border-color: #ddd; -fx-border-radius: 15;">
                    <StackPane prefHeight="300" style="-fx-background-color: #f8f9fa; -fx-background-radius: 10;">
                        <ImageView fx:id="itemImageView" fitHeight="280" fitWidth="400" pickOnBounds="true" preserveRatio="true" />
                    </StackPane>

                    <Label fx:id="ItemNameLabel" alignment="CENTER" prefHeight="32.0" prefWidth="408.0" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: linear-gradient(to right, blue, purple);" text="Tên sản phẩm" textAlignment="CENTER" wrapText="true" />

                    <HBox alignment="CENTER" spacing="10">
                        <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Giá hiện tại:" />
                        <Label fx:id="ItemPriceLabel" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #e74c3c;" text="0 VND" />
                    </HBox>

                    <VBox fx:id="UI02" alignment="CENTER" prefHeight="70" style="-fx-background-color: #f8f9fa; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: green;">
                        <Label fx:id="UI01" style="-fx-text-fill: green; -fx-font-weight: bold;" text="THỜI GIAN CÒN LẠI" />
                        <Label fx:id="lbtimeLeft" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #e74c3c;" text="00:00:00" />
                    </VBox>
                </VBox>

                <!-- ========== BÊN PHẢI: THÔNG TIN CHI TIẾT ========== -->
                <VBox alignment="CENTER" spacing="8" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 15; -fx-border-color: #ddd; -fx-border-radius: 15;" HBox.hgrow="ALWAYS">

                    <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: linear-gradient(to right, blue, purple);" text="📋 THÔNG TIN CHI TIẾT" />
                    <Separator />

                    <!-- Thông tin cơ bản -->
                    <GridPane hgap="10" vgap="8">
                        <Label style="-fx-font-weight: bold;" text="Người đăng:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <Label fx:id="lbTenngban" text="..." GridPane.columnIndex="1" />

                        <Label style="-fx-font-weight: bold;" text="Thời gian bắt đầu:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <Label fx:id="StartTimeLabel" text="..." GridPane.columnIndex="1" GridPane.rowIndex="1" />

                        <Label style="-fx-font-weight: bold;" text="Thời gian kết thúc:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                        <Label fx:id="EndingtimeLabel" text="..." GridPane.columnIndex="1" GridPane.rowIndex="2" />

                        <Label style="-fx-font-weight: bold;" text="Loại sản phẩm:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                        <Label fx:id="lbLoaisp" text="..." GridPane.columnIndex="1" GridPane.rowIndex="3" />

                        <Label style="-fx-font-weight: bold;" text="Giá khởi điểm:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                        <Label fx:id="initPriceLabel" prefHeight="18.0" prefWidth="568.0" text="..." GridPane.columnIndex="1" GridPane.rowIndex="4" />

                        <Label style="-fx-font-weight: bold;" text="Bước giá:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                        <Label fx:id="stepPriceLabel" prefHeight="18.0" prefWidth="565.0" text="..." GridPane.columnIndex="1" GridPane.rowIndex="5" />
   
                       <Label style="-fx-font-weight: bold;" text="Mô tả:" GridPane.rowIndex="6" />
                       <Label fx:id="LbMotasp" prefHeight="83.0" prefWidth="585.0" style="-fx-padding: 0 0 0 10;" text="..." wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="6" />
                  <columnConstraints>
                     <ColumnConstraints />
                     <ColumnConstraints />
                     <ColumnConstraints />
                  </columnConstraints>
                  <rowConstraints>
                     <RowConstraints />
                     <RowConstraints />
                     <RowConstraints />
                     <RowConstraints />
                     <RowConstraints />
                     <RowConstraints />
                     <RowConstraints />
                  </rowConstraints>
                    </GridPane>

                    <Separator />

                    <!-- ========== THÔNG TIN ĐẶC THÙ ========== -->
                    <Label fx:id="detailTitle" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #4b0082;" text="🔍 THÔNG TIN CHI TIẾT" />

                    <!-- Art -->
                    <VBox fx:id="artInfoBox" managed="false" spacing="5" style="-fx-background-color: #fff5f5; -fx-padding: 10; -fx-background-radius: 8; -fx-border-color: #e74c3c; -fx-border-radius: 8;" visible="false">
                        <GridPane hgap="10" vgap="5">
                            <Label style="-fx-font-weight: bold;" text="Tiêu đề:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                            <Label fx:id="artTitleValue" text="..." GridPane.columnIndex="1" GridPane.rowIndex="0" />
                            <Label style="-fx-font-weight: bold;" text="Nghệ sĩ:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                            <Label fx:id="artistValue" text="..." GridPane.columnIndex="1" GridPane.rowIndex="1" />
                            <Label style="-fx-font-weight: bold;" text="Năm sáng tác:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                            <Label fx:id="yearCreatedValue" text="..." GridPane.columnIndex="1" GridPane.rowIndex="2" />
                     <columnConstraints>
                        <ColumnConstraints />
                        <ColumnConstraints />
                     </columnConstraints>
                     <rowConstraints>
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                     </rowConstraints>
                        </GridPane>
                    </VBox>

                    <!-- Vehicle -->
                    <VBox fx:id="vehicleInfoBox" managed="false" spacing="5" style="-fx-background-color: #fff8f0; -fx-padding: 10; -fx-background-radius: 8; -fx-border-color: #f39c12; -fx-border-radius: 8;" visible="false">
                        <GridPane hgap="10" vgap="5">
                            <Label style="-fx-font-weight: bold;" text="Biển số:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                            <Label fx:id="licensePlateValue" text="..." GridPane.columnIndex="1" GridPane.rowIndex="0" />
                            <Label style="-fx-font-weight: bold;" text="Năm SX:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                            <Label fx:id="vehicleYearValue" text="..." GridPane.columnIndex="1" GridPane.rowIndex="1" />
                            <Label style="-fx-font-weight: bold;" text="Hãng xe:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                            <Label fx:id="brandValue" text="..." GridPane.columnIndex="1" GridPane.rowIndex="2" />
                            <Label style="-fx-font-weight: bold;" text="Màu sắc:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                            <Label fx:id="colorValue" text="..." GridPane.columnIndex="1" GridPane.rowIndex="3" />
                     <columnConstraints>
                        <ColumnConstraints />
                        <ColumnConstraints />
                     </columnConstraints>
                     <rowConstraints>
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                     </rowConstraints>
                        </GridPane>
                    </VBox>

                    <!-- Electronics -->
                    <VBox fx:id="electronicsInfoBox" managed="false" spacing="5" style="-fx-background-color: #f0f8ff; -fx-padding: 10; -fx-background-radius: 8; -fx-border-color: #2f80ed; -fx-border-radius: 8;" visible="false">
                        <GridPane hgap="10" vgap="5">
                            <Label style="-fx-font-weight: bold;" text="Hãng SX:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                            <Label fx:id="elecBrandValue" text="..." GridPane.columnIndex="1" GridPane.rowIndex="0" />
                            <Label style="-fx-font-weight: bold;" text="Dòng máy:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                            <Label fx:id="modelValue" text="..." GridPane.columnIndex="1" GridPane.rowIndex="1" />
                     <columnConstraints>
                        <ColumnConstraints />
                        <ColumnConstraints />
                     </columnConstraints>
                     <rowConstraints>
                        <RowConstraints />
                        <RowConstraints />
                     </rowConstraints>
                        </GridPane>
                    </VBox>

                    <Region VBox.vgrow="ALWAYS" />

                    <Button fx:id="ThamGiaDauGiaBtn" onAction="#goToManHinhDauGiaTrucTiep" prefHeight="50" prefWidth="350" style="-fx-background-color: linear-gradient(to right, #6A11CB, #2575FC); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-background-radius: 25; -fx-cursor: hand;" text="THAM GIA ĐẤU GIÁ NGAY" />
                </VBox>

            </HBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox alignment="CENTER" prefHeight="30" style="-fx-background-color: linear-gradient(to right, #FFF0F5, #B3E5FC);">
            <Label style="-fx-font-size: 11px;" text="© 2026 SnowFox - Studio SnowFlake" />
        </HBox>
    </bottom>
</BorderPane>
