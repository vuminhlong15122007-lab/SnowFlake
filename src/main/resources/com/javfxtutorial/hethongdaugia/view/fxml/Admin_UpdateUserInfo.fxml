<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import java.lang.String?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefHeight="530.0" prefWidth="433.0" spacing="20.0" style="-fx-background-color: -sf-surface; -fx-border-color: -sf-border-soft;" stylesheets="@../css/global.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javfxtutorial.hethongdaugia.client.controller.Edit_User_Popup_Controller">
    <styleClass>
        <String fx:value="admin-theme" />
        <String fx:value="admin-popup-card" />
    </styleClass>
    <padding>
        <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
    </padding>

    <HBox prefHeight="100.0" prefWidth="388.0">
        <children>
            <ImageView fitHeight="100.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="true">
                <image>
                    <Image url="@../../assets/Beta01.png" />
                </image>
            </ImageView>
            <Label alignment="CENTER" prefHeight="100.0" prefWidth="288.0" styleClass="admin-popup-heading" text="Thông tin người dùng">
                <font>
                    <Font name="System Bold" size="18.0" />
                </font>
            </Label>
        </children>
    </HBox>

    <GridPane hgap="15.0" vgap="15.0">
        <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" maxWidth="120.0" minWidth="10.0" prefWidth="100.0" />
            <ColumnConstraints hgrow="SOMETIMES" maxWidth="260.0" minWidth="10.0" prefWidth="250.0" />
        </columnConstraints>
        <rowConstraints>
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>

        <Label styleClass="admin-form-label" text="Tên đăng nhập:" GridPane.rowIndex="0" />
        <TextField fx:id="txtName" promptText="nhập tên đăng nhập" styleClass="admin-form-field" GridPane.columnIndex="1" />

        <Label styleClass="admin-form-label" text="Email:" GridPane.rowIndex="1" />
        <TextField fx:id="txtEmail" promptText="example@gmail.com" styleClass="admin-form-field" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label styleClass="admin-form-label" text="Mật khẩu:" GridPane.rowIndex="2" />
        <PasswordField fx:id="txtPassword" promptText="Nhập mật khẩu" styleClass="admin-form-field" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <Label styleClass="admin-form-label" text="Số điện thoại:" GridPane.rowIndex="3" />
        <TextField fx:id="txtPhoneNumber" promptText="Nhập số điện thoại" styleClass="admin-form-field" GridPane.columnIndex="1" GridPane.rowIndex="3" />

        <Label styleClass="admin-form-label" text="Vai trò: " GridPane.rowIndex="4" />
        <ComboBox fx:id="cbRole" prefWidth="260.0" promptText="Chọn vai trò" styleClass="admin-form-field" GridPane.columnIndex="1" GridPane.rowIndex="4" />
    </GridPane>

    <Label fx:id="message" alignment="CENTER" prefHeight="18.0" prefWidth="375.0" style="-fx-text-fill: -sf-danger;" textAlignment="CENTER" />

    <HBox alignment="CENTER_RIGHT" spacing="15.0">
        <VBox.margin>
            <Insets top="10.0" />
        </VBox.margin>
        <Button fx:id="btnCancel" cancelButton="true" mnemonicParsing="false" prefWidth="90.0" styleClass="admin-btn-cancel" text="Hủy" />
        <Button fx:id="btnSave" defaultButton="true" mnemonicParsing="false" onAction="#clickToSave" prefWidth="110.0" styleClass="admin-btn-save" text="Lưu" />
    </HBox>
</VBox>
