<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" stylesheets="@../css/global.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javfxtutorial.hethongdaugia.client.controller.AdminItemController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: linear-gradient(to right, skyblue, lavender);" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
            </padding>
         <ImageView fitHeight="90.0" fitWidth="90.0" pickOnBounds="true" preserveRatio="true">
            <image>
               <Image url="@../../assets/ClassicLogo.png" />
            </image>
         </ImageView>
            <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Bảng Điều Khiển Admin - Quản Lý Sản Phẩm" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="22.0" />
                </font>
            </Label>
            <Region HBox.hgrow="ALWAYS" />
            <TextField fx:id="searchField" prefWidth="250.0" promptText="Tìm kiếm (Tên SP, Danh mục)..." style="-fx-background-radius: 15;" />
            <Button fx:id="btnSearch" mnemonicParsing="false" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 15;" text="Tìm kiếm" />
            <Button fx:id="logOutAd" mnemonicParsing="false" onAction="#clickButtonExit" style="-fx-background-color: #3498db; -fx-text-fill: while; -fx-background-radius: 15;" text="Thoát" textFill="WHITE" />
        </HBox>
    </top>

    <center>
        <VBox spacing="10.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>
            <Label text="Danh sách sản phẩm trên hệ thống">
                <font>
                    <Font name="System Bold" size="16.0" />
                </font>
            </Label>
            <TableView fx:id="itemTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="83.60001200437546" style="-fx-border-color:  #b3c6ff; -fx-font-size: 12px; -fx-background-color: white; -fx-font-weight: bold;" text="Mã SP" />
                    <TableColumn fx:id="colItemName" prefWidth="224.3999786376953" style="-fx-border-color:  #b3c6ff; -fx-font-size: 12px; -fx-background-color: white; -fx-font-weight: bold;" text="Tên sản phẩm" />
                    <TableColumn fx:id="colCategory" prefWidth="113.0" style="-fx-border-color:  #b3c6ff; -fx-font-size: 12px; -fx-background-color: white; -fx-font-weight: bold;" text="Danh mục" />
                    <TableColumn fx:id="colOwner" prefWidth="121.5999755859375" style="-fx-border-color:  #b3c6ff; -fx-font-size: 12px; -fx-background-color: white; -fx-font-weight: bold;" text="Người đăng" />
                    <TableColumn fx:id="colStartPrice" prefWidth="134.20001220703125" style="-fx-border-color:  #b3c6ff; -fx-font-size: 12px; -fx-background-color: white; -fx-font-weight: bold;" text="Giá hiện tại" />
                    <TableColumn fx:id="colStepPrice" prefWidth="173.0" style="-fx-border-color:  #b3c6ff; -fx-font-size: 12px; -fx-background-color: white; -fx-font-weight: bold;" text="Bước giá" />
                    <TableColumn fx:id="colStatus" prefWidth="93.5999755859375" style="-fx-border-color:  #b3c6ff; -fx-font-size: 12px; -fx-background-color: white; -fx-font-weight: bold;" text="Trạng thái" />
                </columns>
            </TableView>
        </VBox>
    </center>

    <right>
        <VBox prefWidth="300.0" spacing="15.0" style="-fx-background-color: #ecf0f1; -fx-border-color: #bdc3c7; -fx-border-width: 0 0 0 1;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="15.0" right="15.0" top="20.0" />
            </padding>

            <Label text="Thao tác quản trị">
                <font>
                    <Font name="System Bold" size="16.0" />
                </font>
            </Label>
            <Button fx:id="btnDeleteProduct" maxWidth="Infinity" mnemonicParsing="false" onAction="#clickToDeleteItem" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold;" text="XÓA SẢN PHẨM" />
            <Button fx:id="UserAdmin" maxWidth="Infinity" mnemonicParsing="false" onAction="#clickToGoUserAdmin" style="-fx-background-color: pink; -fx-text-fill: white; -fx-font-weight: bold;" text="Quản lý User cho Admin" />

        </VBox>
    </right>
</BorderPane>
