<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="164.0" prefWidth="900.0" style="-fx-background-color: -sf-surface; -fx-border-color: -sf-border-muted; -fx-border-radius: 12; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, -sf-shadow-neutral, 8, 0, 0, 2);" stylesheets="@../css/global.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javfxtutorial.hethongdaugia.client.controller.AuctionSessionController">

    <HBox alignment="CENTER_LEFT" spacing="20.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0">

        <!-- ==================== ẢNH SẢN PHẨM ==================== -->
        <StackPane prefHeight="150.0" prefWidth="150.0" style="-fx-background-color: -sf-surface-muted; -fx-background-radius: 12;">
            <ImageView fx:id="productImage" fitHeight="120.0" fitWidth="120.0" pickOnBounds="true" preserveRatio="true" />
        </StackPane>

        <!-- ==================== THÔNG TIN CHÍNH ==================== -->
        <VBox prefHeight="147.0" prefWidth="300.0" spacing="10.0" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <Label fx:id="lbCategory" style="-fx-background-color: linear-gradient(to right, -sf-page-start, -sf-surface); -fx-background-radius: 12; -fx-border-color: -sf-border; -fx-border-radius: 12; -fx-padding: 3 10; -fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: -sf-accent;" text="Loại sản phẩm" />
            </HBox>

            <!-- Tên sản phẩm -->
            <Label fx:id="lbProductName" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: linear-gradient(to right, -sf-purple, -sf-accent);" text="Toyota Camry 2022" />

            <!-- Chi tiết sản phẩm -->
            <HBox alignment="CENTER_LEFT" spacing="5.0">
                <Label prefHeight="20.0" prefWidth="120.0" style="-fx-font-size: 14px; -fx-text-fill: -sf-subtle;" text="Người bán:  " />
                <Label fx:id="lbSellerName" prefHeight="20.0" prefWidth="230.0" style="-fx-font-size: 14px; -fx-text-fill: -sf-subtle; -fx-font-weight: bold;" text="Tên" />
            </HBox>

            <!-- Giá cuối -->
            <HBox alignment="CENTER_LEFT" spacing="5.0">
                <Label fx:id="gia" prefHeight="20.0" prefWidth="120.0" style="-fx-font-size: 14px; -fx-text-fill: -sf-subtle;" text="Giá cuối : " />
                <Label fx:id="lbPrice" prefHeight="20.0" prefWidth="230.0" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: -sf-danger;" text="850,000,000 VND" />
            </HBox>

            <!-- Người thắng -->
            <HBox alignment="CENTER_LEFT" spacing="5.0">
                <Label fx:id="nguoidandau" prefHeight="20.0" prefWidth="120.0" style="-fx-font-size: 14px; -fx-text-fill: -sf-subtle;" text="Người thắng:" />
                <Label fx:id="lbWinner" prefHeight="20.0" prefWidth="230.0" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: -sf-success;" text="user_abc" />
            </HBox>
        </VBox>

        <!-- ==================== KHOẢNG TRỐNG ==================== -->
        <Pane prefHeight="147.0" prefWidth="50.0" />

        <!-- ==================== NÚT HÀNH ĐỘNG ==================== -->
        <VBox alignment="CENTER" prefWidth="140.0" spacing="10.0">
            <Button fx:id="actionButton" alignment="CENTER" onAction="#clickToGoToLiveAuction" prefHeight="40.0" prefWidth="140.0" style="-fx-background-color: -sf-neutral; -fx-text-fill: -sf-on-accent; -fx-font-weight: bold; -fx-font-size: 13px; -fx-background-radius: 25;" text="ĐÃ KẾT THÚC" />
        </VBox>

    </HBox>
      <!-- Tag trạng thái ĐÃ KẾT THÚC (màu xám) -->
      <Label fx:id="statusBadge" layoutY="4.0" style="-fx-background-color: -sf-danger; -fx-text-fill: -sf-on-accent; -fx-font-size: 10px; -fx-font-weight: bold; -fx-padding: 4 10; -fx-background-radius: 8;" text="ĐÃ KẾT THÚC" />
</AnchorPane>
