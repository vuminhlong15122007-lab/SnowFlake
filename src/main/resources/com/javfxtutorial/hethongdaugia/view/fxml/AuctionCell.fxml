<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="164.0" prefWidth="900.0" stylesheets="@../css/global.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javfxtutorial.hethongdaugia.client.controller.AuctionSessionController">
    <styleClass>
        <String fx:value="sf-card" />
        <String fx:value="sf-auction-cell" />
    </styleClass>

    <HBox alignment="CENTER_LEFT" spacing="20.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0">

        <!-- ==================== ẢNH SẢN PHẨM ==================== -->
        <StackPane prefHeight="150.0" prefWidth="150.0" style="-fx-background-color: -sf-surface-muted; -fx-background-radius: 12;">
            <ImageView fx:id="productImage" fitHeight="120.0" fitWidth="120.0" pickOnBounds="true" preserveRatio="true" />
        </StackPane>

        <!-- ==================== THÔNG TIN CHÍNH ==================== -->
        <VBox prefHeight="147.0" prefWidth="300.0" spacing="10.0" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <Label fx:id="lbCategory" styleClass="sf-chip" text="Loại sản phẩm" />
            </HBox>

            <!-- Tên sản phẩm -->
            <Label fx:id="lbProductName" style="-fx-font-size: 20px;" styleClass="sf-section-title" text="Toyota Camry 2022" />

            <!-- Chi tiết sản phẩm -->
            <HBox alignment="CENTER_LEFT" spacing="5.0">
                <Label prefHeight="20.0" prefWidth="120.0" style="-fx-font-size: 14px; -fx-text-fill: -sf-subtle;" text="Người bán:  " />
                <Label fx:id="lbSellerName" prefHeight="20.0" prefWidth="230.0" style="-fx-font-size: 14px; -fx-text-fill: -sf-subtle; -fx-font-weight: bold;" text="Tên" />
            </HBox>

            <!-- Giá cuối -->
            <HBox alignment="CENTER_LEFT" spacing="5.0">
                <Label fx:id="gia" prefHeight="20.0" prefWidth="120.0" style="-fx-font-size: 14px; -fx-text-fill: -sf-subtle;" text="Giá cuối : " />
                <Label fx:id="lbPrice" prefHeight="20.0" prefWidth="230.0" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: -sf-danger;" text="850,000,000 VND" />
            </HBox>

            <!-- Người thắng -->
            <HBox alignment="CENTER_LEFT" spacing="5.0">
                <Label fx:id="nguoidandau" prefHeight="20.0" prefWidth="120.0" style="-fx-font-size: 14px; -fx-text-fill: -sf-subtle;" text="Người thắng:" />
                <Label fx:id="lbWinner" prefHeight="20.0" prefWidth="230.0" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: -sf-success;" text="user_abc" />
            </HBox>
        </VBox>

        <!-- ==================== KHOẢNG TRỐNG ==================== -->
        <Pane prefHeight="147.0" prefWidth="50.0" />

        <!-- ==================== NÚT HÀNH ĐỘNG ==================== -->
        <VBox alignment="CENTER" prefWidth="140.0" spacing="10.0">
            <Button fx:id="actionButton" alignment="CENTER" onAction="#clickToGoToLiveAuction" prefHeight="40.0" prefWidth="140.0" style="-fx-background-color: linear-gradient(to right, #94A3B8, #475569); -fx-text-fill: #FFFFFF; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 18; -fx-border-radius: 18; -fx-border-color: rgba(255,255,255,0.46); -fx-opacity: 1.0;" styleClass="sf-auction-action-neutral" text="ĐÃ KẾT THÚC" />
        </VBox>

    </HBox>
      <!-- Tag trạng thái ĐÃ KẾT THÚC (màu xám) -->
      <Label fx:id="statusBadge" layoutX="12.0" layoutY="8.0" style="-fx-background-color: linear-gradient(to right, #FB7185, #E11D48); -fx-text-fill: #FFFFFF; -fx-font-size: 10px; -fx-font-weight: bold; -fx-padding: 4 10 4 10; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: rgba(255,255,255,0.56); -fx-border-width: 1; -fx-opacity: 1.0;" styleClass="sf-status-badge sf-status-ended" text="ĐÃ KẾT THÚC" />
</AnchorPane>
