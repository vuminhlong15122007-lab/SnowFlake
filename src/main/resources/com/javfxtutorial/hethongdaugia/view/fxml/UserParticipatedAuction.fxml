<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: linear-gradient(to bottom, #e6f7ff, #ffffff);" stylesheets="@../css/global.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javfxtutorial.hethongdaugia.client.controller.ParticipatedAuctionController">

    <!-- ==================== HEADER ==================== -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="5" style="-fx-background-color: linear-gradient(to right, #89CFF0,lavender); -fx-padding: 15;">
            <ImageView fitHeight="50.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true">
                <image><Image url="@../../assets/Logo.png" /></image>
            </ImageView>
            <Label prefHeight="32.0" prefWidth="288.0" style="-fx-font-size: 22px; -fx-text-fill: linear-gradient(to right, purple, #2f80ed); -fx-font-weight: bold;" text="SnowFox - Thanh toán" />
            <Region HBox.hgrow="ALWAYS" />
            <TextField fx:id="searchField" prefWidth="250" promptText="🔍  Tìm kiếm phiên đấu giá..." style="-fx-background-color: #ffffff; -fx-background-radius: 20; -fx-border-radius: 20; -fx-border-color: #dcdde1; -fx-padding: 8;" />
            <Button style="-fx-background-color: #2f80ed; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 8 20;" text="🔍 Search" />
        </HBox>
    </top>

    <!-- ==================== MENU TRÁI ==================== -->
    <left>
        <VBox prefWidth="246.0" spacing="14" style="-fx-padding: 22 16 18 22; -fx-background-color: transparent;">
            <VBox prefHeight="317.0" prefWidth="208.0" spacing="10" style="-fx-background-color: rgba(255,255,255,0.72); -fx-background-radius: 28; -fx-border-color: rgba(47,128,237,0.14); -fx-border-radius: 28; -fx-border-width: 1; -fx-padding: 18; -fx-effect: dropshadow(gaussian, rgba(47,128,237,0.12), 20, 0, 0, 6);">

                <Button fx:id="btnAll" maxWidth="Infinity" prefHeight="44.0" style="-fx-background-color: linear-gradient(to right, #56ccf2, #2f80ed); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 14; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 16; -fx-effect: dropshadow(gaussian, rgba(47,128,237,0.25), 10, 0, 0, 3);" text="📋  Tất cả" />

                <Button fx:id="btnDTGia" maxWidth="Infinity" prefHeight="44.0" style="-fx-background-color: white; -fx-text-fill: #607087; -fx-font-weight: bold; -fx-background-radius: 14; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 16; -fx-border-color: #d9e8ff; -fx-border-radius: 14;" text="⚡  Đang tham gia" />

                <Button fx:id="btnDaThamGia" maxWidth="Infinity" prefHeight="44.0" style="-fx-background-color: white; -fx-text-fill: #607087; -fx-font-weight: bold; -fx-background-radius: 14; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 16; -fx-border-color: #d9e8ff; -fx-border-radius: 14;" text="🔨 Đã tham gia" />

                <Button fx:id="btnCTToan" maxWidth="Infinity" prefHeight="44.0" style="-fx-background-color: white; -fx-text-fill: #607087; -fx-font-weight: bold; -fx-background-radius: 14; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 16; -fx-border-color: #d9e8ff; -fx-border-radius: 14;" text="💳  Chờ thanh toán" />
                <Button fx:id="btnDTToan" maxWidth="Infinity" prefHeight="44.0" style="-fx-background-color: white; -fx-text-fill: #607087; -fx-font-weight: bold; -fx-background-radius: 14; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 16; -fx-border-color: #d9e8ff; -fx-border-radius: 14;" text="✅  Đã thanh toán" />
                <Button fx:id="btnDaHuy" maxWidth="Infinity" prefHeight="44.0" style="-fx-background-color: white; -fx-text-fill: #607087; -fx-font-weight: bold; -fx-background-radius: 14; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 16; -fx-border-color: #d9e8ff; -fx-border-radius: 14;" text="❌  Đã bị hủy" textFill="#2b2323" />

            </VBox>

            <VBox spacing="10" style="-fx-background-color: linear-gradient(to bottom right, rgba(255,255,255,0.82), rgba(230,247,255,0.82)); -fx-background-radius: 26; -fx-border-color: rgba(47,128,237,0.13); -fx-border-radius: 26; -fx-padding: 16; -fx-effect: dropshadow(gaussian, rgba(47,128,237,0.10), 18, 0, 0, 5);">
                <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #4b0082;" text="Lưu ý" />
                <Label prefHeight="91.0" prefWidth="173.0" style="-fx-font-size: 12px; -fx-text-fill: #61708a; -fx-line-spacing: 3;" text="Tại đây bạn có thể xem phiên đấu giá bạn đã tham gia và thanh toán đúng hạn với những phiên đã thắng." wrapText="true" />
            </VBox>

            <Region VBox.vgrow="ALWAYS" />
            <Button fx:id="goMenu" maxWidth="Infinity" onAction="#goMenu" prefHeight="45.0" prefWidth="146.0" style="-fx-background-color: linear-gradient(to right, #56ccf2, #2f80ed); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 14; -fx-border-radius: 14;" text="←  Trang chủ">
            </Button>
        </VBox>
    </left>

    <!-- ==================== NỘI DUNG CHÍNH ==================== -->
    <center>
        <StackPane style="-fx-padding: 22 24 18 6;">
            <VBox spacing="16" style="-fx-background-color: rgba(255,255,255,0.62); -fx-background-radius: 32; -fx-border-color: rgba(47,128,237,0.13); -fx-border-radius: 32; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(47,128,237,0.12), 24, 0, 0, 8);">
                <HBox alignment="CENTER_LEFT" spacing="14">
                    <VBox spacing="3">
                        <Label fx:id="sectionTitle" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #263859;" text="📋  TẤT CẢ PHIÊN ĐẤU GIÁ ĐÃ THAM GIA" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                </HBox>

                <StackPane style="-fx-background-color: linear-gradient(to bottom, rgba(255,255,255,0.78), rgba(240,250,255,0.68)); -fx-background-radius: 26; -fx-border-color: rgba(47,128,237,0.10); -fx-border-radius: 26; -fx-padding: 12;" VBox.vgrow="ALWAYS">
                    <ListView fx:id="productList" style="-fx-background-color: transparent; -fx-background-insets: 0; -fx-control-inner-background: transparent; -fx-padding: 4;" />
                </StackPane>
            </VBox>
        </StackPane>
    </center>

    <!-- ==================== FOOTER ==================== -->
    <bottom>
        <HBox alignment="CENTER" style="-fx-background-color: linear-gradient(to right, #FFF0F5, #B3E5FC); -fx-padding: 8;">
            <Label style="-fx-font-size: 12px; -fx-text-fill: #902a2a;" text="© 2026 SnowFox - Studio SnowFlake" />
        </HBox>
    </bottom>
</BorderPane>
