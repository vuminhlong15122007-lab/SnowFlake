<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="720.0" prefWidth="1280.0" styleClass="sf-page" stylesheets="@../css/global.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javfxtutorial.hethongdaugia.client.controller.ParticipatedAuctionController">

    <!-- ==================== HEADER ==================== -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="5" style="-fx-background-color: linear-gradient(to right, -sf-surface-raised, -sf-page-soft); -fx-padding: 15;">
            <ImageView fitHeight="50.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true">
                <image><Image url="@../../assets/Logo.png" /></image>
            </ImageView>
            <Label prefHeight="32.0" prefWidth="288.0" styleClass="sf-title" text="SnowFox - Thanh toán" />
            <Region HBox.hgrow="ALWAYS" />
            <TextField fx:id="searchField" prefWidth="250" promptText="🔍  Tìm kiếm phiên đấu giá..." style="-fx-background-color: -sf-surface; -fx-background-radius: 20; -fx-border-radius: 20; -fx-border-color: -sf-border-soft; -fx-padding: 8;" />
            <Button styleClass="sf-btn-primary" text="🔍 Search" />
        </HBox>
    </top>

    <!-- ==================== MENU TRÁI ==================== -->
    <left>
        <VBox prefWidth="246.0" spacing="14" style="-fx-padding: 22 16 18 22; -fx-background-color: transparent;">
            <VBox prefHeight="317.0" prefWidth="208.0" spacing="10" style="-fx-background-color: -sf-panel; -fx-background-radius: 28; -fx-border-color: -sf-border-soft; -fx-border-radius: 28; -fx-border-width: 1; -fx-padding: 18; -fx-effect: dropshadow(gaussian, -sf-shadow-soft, 20, 0, 0, 6);">

                <Button fx:id="btnAll" maxWidth="Infinity" prefHeight="44.0" styleClass="sf-filter-button-active" text="📋  Tất cả" />

                <Button fx:id="btnDTGia" maxWidth="Infinity" prefHeight="44.0" styleClass="sf-filter-button" text="⚡  Đang tham gia" />

                <Button fx:id="btnDaThamGia" maxWidth="Infinity" prefHeight="44.0" styleClass="sf-filter-button" text="🔨 Đã tham gia" />

                <Button fx:id="btnCTToan" maxWidth="Infinity" prefHeight="44.0" styleClass="sf-filter-button" text="💳  Chờ thanh toán" />
                <Button fx:id="btnDTToan" maxWidth="Infinity" prefHeight="44.0" styleClass="sf-filter-button" text="✅  Đã thanh toán" />
                <Button fx:id="btnDaHuy" maxWidth="Infinity" prefHeight="44.0" styleClass="sf-filter-button" text="❌  Đã bị hủy" />

            </VBox>

            <VBox spacing="10" style="-fx-background-color: linear-gradient(to bottom right, -sf-panel, -sf-panel-soft); -fx-background-radius: 26; -fx-border-color: -sf-border-soft; -fx-border-radius: 26; -fx-padding: 16; -fx-effect: dropshadow(gaussian, -sf-shadow-soft, 18, 0, 0, 5);">
                <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: -sf-accent;" text="Lưu ý" />
                <Label prefHeight="91.0" prefWidth="173.0" style="-fx-font-size: 12px; -fx-text-fill: -sf-muted; -fx-line-spacing: 3;" text="Tại đây bạn có thể xem phiên đấu giá bạn đã tham gia và thanh toán đúng hạn với những phiên đã thắng." wrapText="true" />
            </VBox>

            <Region VBox.vgrow="ALWAYS" />
            <Button fx:id="goMenu" maxWidth="Infinity" onAction="#goMenu" prefHeight="45.0" prefWidth="146.0" styleClass="sf-btn-primary" text="←  Trang chủ">
            </Button>
        </VBox>
    </left>

    <!-- ==================== NỘI DUNG CHÍNH ==================== -->
    <center>
        <StackPane style="-fx-padding: 22 24 18 6;">
            <VBox spacing="16" style="-fx-background-color: -sf-panel; -fx-background-radius: 32; -fx-border-color: -sf-border-soft; -fx-border-radius: 32; -fx-padding: 20; -fx-effect: dropshadow(gaussian, -sf-shadow-soft, 24, 0, 0, 8);">
                <HBox alignment="CENTER_LEFT" spacing="14">
                    <VBox spacing="3">
                        <Label fx:id="sectionTitle" styleClass="sf-section-title" text="📋  TẤT CẢ PHIÊN ĐẤU GIÁ ĐÃ THAM GIA" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                </HBox>

                <StackPane style="-fx-background-color: linear-gradient(to bottom, -sf-surface, -sf-surface-soft); -fx-background-radius: 26; -fx-border-color: -sf-border-soft; -fx-border-radius: 26; -fx-padding: 12;" VBox.vgrow="ALWAYS">
                    <ListView fx:id="productList" style="-fx-background-color: transparent; -fx-background-insets: 0; -fx-control-inner-background: transparent; -fx-padding: 4;" />
                </StackPane>
            </VBox>
        </StackPane>
    </center>

    <!-- ==================== FOOTER ==================== -->
    <bottom>
        <HBox alignment="CENTER" styleClass="sf-footer">
            <Label style="-fx-font-size: 12px; -fx-text-fill: -sf-muted;" text="© 2026 SnowFox - Studio SnowFlake" />
        </HBox>
    </bottom>
</BorderPane>
