<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: linear-gradient(to bottom, -sf-page-start, -sf-surface);" stylesheets="@../css/global.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javfxtutorial.hethongdaugia.client.controller.AdminItemController">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="67.0" prefWidth="1280.0" spacing="16.0" style="-fx-background-color: linear-gradient(to right, -sf-surface-raised, -sf-surface, -sf-page-start);                      -fx-border-color: -sf-border;                      -fx-border-width: 0 0 1 0;                      -fx-effect: dropshadow(gaussian, -sf-shadow, 12, 0.2, 0, 3);">
            <padding>
                <Insets bottom="12.0" left="22.0" right="22.0" top="12.0" />
            </padding>

            <ImageView fitHeight="52.0" fitWidth="52.0" pickOnBounds="true" preserveRatio="true">
                <image>
                    <Image url="@../../assets/Beta01.png" />
                </image>
            </ImageView>

            <VBox alignment="CENTER_LEFT" spacing="4.0">
                <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: linear-gradient(to right, -sf-purple, -sf-accent);" text="Bảng Điều Khiển Admin" />
                <Label style="-fx-font-size: 13px; -fx-text-fill: -sf-text; -fx-font-weight: bold;" text="Quản lý sản phẩm và phiên đấu giá" />
            </VBox>

            <Region HBox.hgrow="ALWAYS" />

            <HBox alignment="CENTER" spacing="8.0" style="-fx-background-color: -sf-panel;                          -fx-background-radius: 22;                          -fx-border-color: -sf-border-soft;                          -fx-border-radius: 22;                          -fx-padding: 7 8 7 12;">
                <TextField fx:id="searchField" prefHeight="34.0" prefWidth="275.0" promptText="Tìm kiếm tên sản phẩm, danh mục..." style="-fx-background-color: transparent;                                   -fx-border-color: transparent;                                   -fx-font-size: 13px;" />
                <Button fx:id="btnSearch" prefHeight="34.0" prefWidth="81.0" style="-fx-background-color: linear-gradient(to right, -sf-accent-2, -sf-accent); -fx-background-radius: 18; -fx-text-fill: -sf-on-accent; -fx-font-weight: bold; -fx-cursor: hand;" text="Tìm kiếm" />
            </HBox>
        </HBox>
    </top>

    <center>
        <VBox spacing="12.0" style="-fx-background-color: -sf-panel-soft;">
            <padding>
                <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
            </padding>

            <Label style="-fx-font-size: 18px;                           -fx-font-weight: bold;                           -fx-text-fill: linear-gradient(to right, -sf-purple, -sf-accent);" text="Danh sách sản phẩm trên hệ thống" />

            <TableView fx:id="itemTable" style="-fx-background-color: -sf-surface;                               -fx-background-radius: 10;                               -fx-border-color: -sf-border;                               -fx-border-radius: 10;                               -fx-table-cell-border-color: -sf-page-start;                               -fx-control-inner-background: -sf-surface;                               -fx-control-inner-background-alt: -sf-surface-soft;                               -fx-selection-bar: -sf-accent;                               -fx-selection-bar-non-focused: -sf-accent-2;" styleClass="admin-product-table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="83.60001200437546" text="Mã SP" />
                    <TableColumn fx:id="colItemName" prefWidth="224.3999786376953" text="Tên sản phẩm" />
                    <TableColumn fx:id="colCategory" prefWidth="113.0" text="Danh mục" />
                    <TableColumn fx:id="colOwner" prefWidth="121.5999755859375" text="Người đăng" />
                    <TableColumn fx:id="colStartPrice" prefWidth="134.20001220703125" text="Giá hiện tại" />
                    <TableColumn fx:id="colStepPrice" prefWidth="173.0" text="Bước giá" />
                    <TableColumn fx:id="colStatus" prefWidth="93.5999755859375" text="Trạng thái" />
                </columns>
            </TableView>
        </VBox>
    </center>

    <right>
        <VBox alignment="TOP_CENTER" prefWidth="300.0" spacing="18.0" style="-fx-background-color: -sf-surface-raised;                      -fx-border-color: -sf-border;                      -fx-border-width: 0 0 0 1;">
            <padding>
                <Insets bottom="24.0" left="20.0" right="20.0" top="28.0" />
            </padding>

            <Label style="-fx-font-size: 18px;                           -fx-font-weight: bold;                           -fx-text-fill: linear-gradient(to right, -sf-purple, -sf-accent);" text="Thao tác quản trị" />

            <Button fx:id="UserAdmin" maxWidth="Infinity" onAction="#clickToGoUserAdmin" prefHeight="44.0" style="-fx-background-color: linear-gradient(to right, -sf-border, -sf-accent-2); -fx-background-radius: 10; -fx-text-fill: -sf-on-accent; -fx-font-weight: bold; -fx-cursor: hand;" text="Quản lý người dùng" />

            <Button fx:id="btnDeleteProduct" maxWidth="Infinity" onAction="#clickToDeleteItem" prefHeight="44.0" style="-fx-background-color: -sf-danger;                            -fx-background-radius: 10;                            -fx-text-fill: -sf-on-accent;                            -fx-font-weight: bold;                            -fx-cursor: hand;" text="Xóa sản phẩm" />

            <Region VBox.vgrow="ALWAYS" />

            <Separator />

            <Button fx:id="logOutAd" maxWidth="Infinity" onAction="#clickButtonExit" prefHeight="42.0" style="-fx-background-color: -sf-neutral; -fx-background-radius: 10; -fx-text-fill: -sf-on-accent; -fx-font-weight: bold; -fx-cursor: hand;" text="Thoát" />
        </VBox>
    </right>
</BorderPane>
