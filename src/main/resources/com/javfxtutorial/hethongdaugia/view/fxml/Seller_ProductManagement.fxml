<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.collections.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<StackPane maxHeight="720.0" maxWidth="1280.0" minHeight="720.0" minWidth="1280.0" prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javfxtutorial.hethongdaugia.client.controller.SellerManagementController">

<BorderPane maxHeight="720.0" maxWidth="1280.0" minHeight="720.0" minWidth="1280.0" prefHeight="720.0" prefWidth="1280.0" styleClass="sf-page" stylesheets="@../css/global.css">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="62.0" prefWidth="1280.0" spacing="14.0" styleClass="sf-header-soft">
            <padding>
                <Insets bottom="8.0" left="20.0" right="20.0" top="8.0" />
            </padding>
            <ImageView fitHeight="46.0" fitWidth="46.0" pickOnBounds="true" preserveRatio="true">
                <image><Image url="@../../assets/ClassicLogo.png" /></image>
            </ImageView>
            <VBox alignment="CENTER_LEFT" spacing="1.0">
                <Label styleClass="sf-title" text="SnowFox" />
                <Label style="-fx-font-size: 12px; -fx-text-fill: -sf-muted; -fx-font-weight: bold;" text="Quản lý sản phẩm và phiên đấu giá của bạn" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <StackPane onMouseClicked="#openNotifications" style="-fx-cursor: hand;">
                <Label style="-fx-font-size: 26px;" text="🔔" />
                <Label fx:id="badgeLabel" style="-fx-background-color: -sf-danger; -fx-text-fill: -sf-on-accent; -fx-background-radius: 10; -fx-font-size: 10px; -fx-padding: 1 5; -fx-font-weight: bold;" text="0" translateX="8" translateY="-4" StackPane.alignment="TOP_RIGHT" />
            </StackPane>
            <Button fx:id="goMenu" onAction="#goMenu" prefHeight="34.0" prefWidth="105.0" styleClass="sf-btn-primary" text="Trang chủ" />
        </HBox>
    </top>

    <center>
        <HBox prefHeight="632.0" prefWidth="1280.0" spacing="14.0" style="-fx-padding: 14 16 12 16;">

            <!-- ── Cột trái: danh sách sản phẩm ── -->
            <VBox maxWidth="330.0" prefWidth="330.0" spacing="10.0" styleClass="sf-card">
                <padding><Insets bottom="12.0" left="12.0" right="12.0" top="12.0" /></padding>
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <VBox alignment="CENTER_LEFT" spacing="1.0">
                        <Label style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: -sf-heading;" text="Kho sản phẩm" />
                        <Label style="-fx-font-size: 11px; -fx-text-fill: -sf-muted;" text="Chọn sản phẩm để sửa hoặc xóa" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <Button onAction="#onReloadButton" prefHeight="30.0" prefWidth="30.0" styleClass="sf-btn-primary" text="↺" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
                </HBox>
                <ComboBox fx:id="filterComboBox" maxWidth="Infinity" prefHeight="32.0" promptText="Trạng thái" style="-fx-background-color: -sf-surface; -fx-background-radius: 10; -fx-border-color: -sf-border-soft; -fx-border-radius: 10; -fx-font-size: 12px;" />
                <ListView fx:id="productList" prefHeight="500.0" prefWidth="306.0" styleClass="sf-transparent-list" VBox.vgrow="ALWAYS" />
                <HBox alignment="CENTER" spacing="10.0">
                    <Button onAction="#onAddButton" prefHeight="36.0" prefWidth="134.0" styleClass="sf-btn-success" text="+ Thêm" />
                    <Button onAction="#deleteAuction" prefHeight="36.0" prefWidth="134.0" styleClass="sf-btn-danger" text="Xóa" />
                </HBox>
            </VBox>

            <!-- ── Cột phải: chi tiết ── -->
            <VBox spacing="10.0" styleClass="sf-card" HBox.hgrow="ALWAYS">
                <padding><Insets bottom="12.0" left="14.0" right="14.0" top="12.0" /></padding>

                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <VBox alignment="CENTER_LEFT" spacing="1.0">
                        <Label styleClass="sf-section-title" text="Chi tiết phiên đấu giá" />
                        <Label style="-fx-font-size: 11px; -fx-text-fill: -sf-muted;" text="Nhập thông tin sản phẩm, giá và thời gian mở phiên" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                </HBox>

                <!-- ══ PANEL 1: Người thắng (CLOSED có winner / PAID) ══ -->
                <VBox fx:id="winnerInfoBox" managed="false" spacing="16.0" style="-fx-background-color: linear-gradient(to bottom right, -sf-surface-soft, -sf-surface); -fx-background-radius: 16; -fx-border-color: -sf-border-soft; -fx-border-radius: 16; -fx-padding: 20;" visible="false" VBox.vgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label style="-fx-font-size: 22px;" text="🏆" />
                        <VBox spacing="2.0">
                            <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: -sf-heading;" text="Kết quả đấu giá" />
                            <Label fx:id="winnerStatusLabel" style="-fx-font-size: 11px; -fx-text-fill: -sf-muted;" text="Phiên đấu giá đã kết thúc" />
                        </VBox>
                    </HBox>
                    <VBox spacing="12.0" style="-fx-background-color: -sf-surface; -fx-background-radius: 14; -fx-border-color: -sf-border-soft; -fx-border-radius: 14; -fx-padding: 16;">
                        <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: -sf-muted; -fx-padding: 0 0 4 0;" text="THÔNG TIN SẢN PHẨM" />
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <Label style="-fx-font-size: 12px; -fx-text-fill: -sf-muted; -fx-min-width: 120;" text="Tên sản phẩm:" />
                            <Label fx:id="winnerProductName" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: -sf-heading;" text="—" />
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <Label style="-fx-font-size: 12px; -fx-text-fill: -sf-muted; -fx-min-width: 120;" text="Giá chốt:" />
                            <Label fx:id="winnerFinalPrice" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: -sf-danger;" text="—" />
                        </HBox>
                    </VBox>
                    <VBox spacing="12.0" style="-fx-background-color: linear-gradient(to right, -sf-success-soft, -sf-surface); -fx-background-radius: 14; -fx-border-color: -sf-success; -fx-border-radius: 14; -fx-border-width: 1.5; -fx-padding: 16;">
                        <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: -sf-success; -fx-padding: 0 0 4 0;" text="🥇  NGƯỜI THẮNG ĐẤU GIÁ" />
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <Label style="-fx-font-size: 12px; -fx-text-fill: -sf-muted; -fx-min-width: 120;" text="Họ tên:" />
                            <Label fx:id="winnerName" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: -sf-heading;" text="—" />
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <Label style="-fx-font-size: 12px; -fx-text-fill: -sf-muted; -fx-min-width: 120;" text="Giá đặt thắng:" />
                            <Label fx:id="winnerBidPrice" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: -sf-success;" text="—" />
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <Label style="-fx-font-size: 12px; -fx-text-fill: -sf-muted; -fx-min-width: 120;" text="Email:" />
                            <Label fx:id="winnerEmail" style="-fx-font-size: 13px; -fx-text-fill: -sf-accent;" text="—" />
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <Label style="-fx-font-size: 12px; -fx-text-fill: -sf-muted; -fx-min-width: 120;" text="Số điện thoại:" />
                            <Label fx:id="winnerSdt" style="-fx-font-size: 13px; -fx-text-fill: -sf-accent;" text="—" />
                        </HBox>
                    </VBox>
                    <Region VBox.vgrow="ALWAYS" />
                    <Button onAction="#onBackToForm" prefHeight="36.0" prefWidth="160.0" style="-fx-background-color: -sf-surface; -fx-text-fill: -sf-text; -fx-font-weight: bold; -fx-background-radius: 10; -fx-border-color: -sf-border-soft; -fx-border-radius: 10; -fx-cursor: hand;" text="← Quay lại" />
                </VBox>

                <!-- ══ PANEL 2: Thông báo hủy / không ai đấu giá ══
                     Ngang cấp winnerInfoBox và detailFormBox — KHÔNG nằm trong detailFormBox -->
                <VBox fx:id="cancelledInfoBox" managed="false" spacing="16.0" style="-fx-background-color: linear-gradient(to bottom right, -sf-surface-soft, -sf-surface); -fx-background-radius: 16; -fx-border-color: -sf-border-soft; -fx-border-radius: 16; -fx-padding: 20;" visible="false" VBox.vgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label fx:id="cancelledIcon" style="-fx-font-size: 22px;" text="⚠️" />
                        <VBox spacing="2.0">
                            <Label fx:id="cancelledTitle" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: -sf-heading;" text="Phiên đấu giá đã bị hủy" />
                            <Label fx:id="cancelledSubtitle" style="-fx-font-size: 11px; -fx-text-fill: -sf-muted;" text="Phiên này không thể tiếp tục" />
                        </VBox>
                    </HBox>

                    <!-- Card thông tin người vi phạm (ẩn nếu không có winner) -->
                    <VBox fx:id="cancelledUserCard" managed="false" spacing="12.0" style="-fx-background-color: linear-gradient(to right, -sf-danger-soft, -sf-surface); -fx-background-radius: 14; -fx-border-color: -sf-danger; -fx-border-radius: 14; -fx-border-width: 1.5; -fx-padding: 16;" visible="false">
                        <Label fx:id="cancelledCardTitle" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: -sf-danger; -fx-padding: 0 0 4 0;" text="👤  THÔNG TIN NGƯỜI VI PHẠM" />
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <Label style="-fx-font-size: 12px; -fx-text-fill: -sf-muted; -fx-min-width: 130;" text="Họ tên:" />
                            <Label fx:id="cancelledUserName" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: -sf-heading;" text="—" />
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <Label style="-fx-font-size: 12px; -fx-text-fill: -sf-muted; -fx-min-width: 130;" text="Số điện thoại:" />
                            <Label fx:id="cancelledUserSdt" style="-fx-font-size: 13px; -fx-text-fill: -sf-accent;" text="—" />
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <Label style="-fx-font-size: 12px; -fx-text-fill: -sf-muted; -fx-min-width: 130;" text="Email:" />
                            <Label fx:id="cancelledUserEmail" style="-fx-font-size: 13px; -fx-text-fill: -sf-accent;" text="—" />
                        </HBox>
                    </VBox>

                    <Region VBox.vgrow="ALWAYS" />
                    <Button onAction="#onBackToForm" prefHeight="36.0" prefWidth="160.0" style="-fx-background-color: -sf-surface; -fx-text-fill: -sf-text; -fx-font-weight: bold; -fx-background-radius: 10; -fx-border-color: -sf-border-soft; -fx-border-radius: 10; -fx-cursor: hand;" text="← Quay lại" />
                </VBox>

                <!-- ══ PANEL 3: Form chỉnh sửa (NOT_START / RUNNING) ══ -->
                <VBox fx:id="detailFormBox" spacing="0" VBox.vgrow="ALWAYS">
                    <HBox spacing="14.0" VBox.vgrow="ALWAYS">

                        <VBox maxWidth="244.0" prefWidth="244.0" spacing="10.0" style="-fx-background-color: linear-gradient(to bottom, -sf-surface-soft, -sf-surface); -fx-background-radius: 16; -fx-border-color: -sf-border-soft; -fx-border-radius: 16; -fx-padding: 12;">
                            <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: -sf-heading;" text="Ảnh sản phẩm" />
                            <StackPane prefHeight="238.0" prefWidth="220.0" style="-fx-background-color: -sf-surface; -fx-background-radius: 16; -fx-border-color: -sf-border-soft; -fx-border-radius: 16; -fx-effect: dropshadow(gaussian, -sf-shadow-soft, 10, 0.15, 0, 2);">
                                <ImageView fx:id="Image" fitHeight="203.0" fitWidth="194.0" pickOnBounds="true" preserveRatio="true">
                                    <image><Image url="@../../assets/LogoUser.jpg" /></image>
                                </ImageView>
                            </StackPane>
                            <Button fx:id="btupImg" maxWidth="Infinity" onAction="#clickToChooseImage" prefHeight="36.0" styleClass="sf-btn-primary" text="Tải ảnh lên" />
                            <VBox spacing="6.0" style="-fx-background-color: -sf-surface-soft; -fx-background-radius: 14; -fx-padding: 10; -fx-border-color: -sf-border-soft; -fx-border-radius: 14;">
                                <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: -sf-text;" text="Gợi ý nhập liệu" />
                                <Label style="-fx-font-size: 11px; -fx-text-fill: -sf-muted;" text="• Giá và bước giá nhập số" />
                                <Label style="-fx-font-size: 11px; -fx-text-fill: -sf-muted;" text="• Chọn phân loại để mở form riêng" />
                                <Label style="-fx-font-size: 11px; -fx-text-fill: -sf-muted;" text="• Thời gian kết thúc phải sau bắt đầu" />
                            </VBox>
                            <Region VBox.vgrow="ALWAYS" />
                        </VBox>

                        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                            <TextField fx:id="nameField" prefHeight="34.0" promptText="Tên sản phẩm" style="-fx-background-color: -sf-surface; -fx-background-radius: 10; -fx-border-color: -sf-border-soft; -fx-border-radius: 10; -fx-font-size: 13px; -fx-padding: 0 12;" />
                            <TextArea fx:id="descriptionField" prefHeight="72.0" promptText="Mô tả sản phẩm" style="-fx-background-color: -sf-surface; -fx-background-radius: 10; -fx-border-color: -sf-border-soft; -fx-border-radius: 10; -fx-font-size: 13px;" wrapText="true" />
                            <HBox spacing="8.0">
                                <TextField fx:id="priceField" prefHeight="34.0" promptText="Giá khởi điểm / giá hiện tại" style="-fx-background-color: -sf-surface; -fx-background-radius: 10; -fx-border-color: -sf-border-soft; -fx-border-radius: 10; -fx-font-size: 13px; -fx-padding: 0 12;" HBox.hgrow="ALWAYS" />
                                <TextField fx:id="tfstepPrice" prefHeight="34.0" promptText="Bước giá" style="-fx-background-color: -sf-surface; -fx-background-radius: 10; -fx-border-color: -sf-border-soft; -fx-border-radius: 10; -fx-font-size: 13px; -fx-padding: 0 12;" HBox.hgrow="ALWAYS" />
                                <ComboBox fx:id="categoryComboBox" prefHeight="34.0" prefWidth="178.0" promptText="Phân loại" style="-fx-background-color: -sf-surface; -fx-background-radius: 10; -fx-border-color: -sf-border-soft; -fx-border-radius: 10; -fx-font-size: 13px;">
                                    <items><FXCollections fx:factory="observableArrayList" /></items>
                                </ComboBox>
                            </HBox>

                            <StackPane maxHeight="126.0" minHeight="126.0" prefHeight="126.0">
                                <VBox alignment="CENTER" mouseTransparent="true" style="-fx-background-color: -sf-surface-soft; -fx-background-radius: 14; -fx-border-color: -sf-border-soft; -fx-border-radius: 14; -fx-padding: 10;">
                                    <Label style="-fx-font-size: 12px; -fx-text-fill: -sf-subtle; -fx-font-weight: bold;" text="Chọn ART / VEHICLE / ELECTRONICS để nhập thông tin riêng" />
                                </VBox>
                                <VBox fx:id="artFields" managed="false" spacing="7.0" style="-fx-background-color: -sf-danger-soft; -fx-background-radius: 14; -fx-border-color: -sf-danger-soft; -fx-border-radius: 14; -fx-padding: 10;" visible="false">
                                    <Label style="-fx-font-size: 13px; -fx-text-fill: -sf-danger; -fx-font-weight: bold;" text="Thông tin tác phẩm nghệ thuật" />
                                    <HBox spacing="8.0">
                                        <TextField fx:id="artTitleField" promptText="Tiêu đề tác phẩm" style="-fx-background-color: -sf-surface; -fx-background-radius: 9; -fx-border-color: -sf-danger-soft; -fx-border-radius: 9;" HBox.hgrow="ALWAYS" />
                                        <TextField fx:id="artistField" promptText="Nghệ sĩ" style="-fx-background-color: -sf-surface; -fx-background-radius: 9; -fx-border-color: -sf-danger-soft; -fx-border-radius: 9;" HBox.hgrow="ALWAYS" />
                                    </HBox>
                                    <TextField fx:id="yearCreatedField" promptText="Năm sáng tác" style="-fx-background-color: -sf-surface; -fx-background-radius: 9; -fx-border-color: -sf-danger-soft; -fx-border-radius: 9;" />
                                </VBox>
                                <VBox fx:id="vehicleFields" managed="false" spacing="7.0" style="-fx-background-color: -sf-warning-soft; -fx-background-radius: 14; -fx-border-color: -sf-warning; -fx-border-radius: 14; -fx-padding: 10;" visible="false">
                                    <Label style="-fx-font-size: 13px; -fx-text-fill: -sf-warning; -fx-font-weight: bold;" text="Thông tin phương tiện" />
                                    <HBox spacing="8.0">
                                        <TextField fx:id="licensePlateField" promptText="Biển số" style="-fx-background-color: -sf-surface; -fx-background-radius: 9; -fx-border-color: -sf-warning; -fx-border-radius: 9;" HBox.hgrow="ALWAYS" />
                                        <TextField fx:id="vehicleYearField" promptText="Năm sản xuất" style="-fx-background-color: -sf-surface; -fx-background-radius: 9; -fx-border-color: -sf-warning; -fx-border-radius: 9;" HBox.hgrow="ALWAYS" />
                                    </HBox>
                                    <HBox spacing="8.0">
                                        <TextField fx:id="brandVehicleField" promptText="Hãng xe" style="-fx-background-color: -sf-surface; -fx-background-radius: 9; -fx-border-color: -sf-warning; -fx-border-radius: 9;" HBox.hgrow="ALWAYS" />
                                        <TextField fx:id="colorField" promptText="Màu sắc" style="-fx-background-color: -sf-surface; -fx-background-radius: 9; -fx-border-color: -sf-warning; -fx-border-radius: 9;" HBox.hgrow="ALWAYS" />
                                    </HBox>
                                </VBox>
                                <VBox fx:id="electronicsFields" managed="false" spacing="7.0" style="-fx-background-color: -sf-surface-soft; -fx-background-radius: 14; -fx-border-color: -sf-border; -fx-border-radius: 14; -fx-padding: 10;" visible="false">
                                    <Label style="-fx-font-size: 13px; -fx-text-fill: -sf-accent; -fx-font-weight: bold;" text="Thông tin thiết bị điện tử" />
                                    <HBox spacing="8.0">
                                        <TextField fx:id="brandElecField" promptText="Hãng sản xuất" style="-fx-background-color: -sf-surface; -fx-background-radius: 9; -fx-border-color: -sf-border; -fx-border-radius: 9;" HBox.hgrow="ALWAYS" />
                                        <TextField fx:id="modelField" promptText="Dòng máy / model" style="-fx-background-color: -sf-surface; -fx-background-radius: 9; -fx-border-color: -sf-border; -fx-border-radius: 9;" HBox.hgrow="ALWAYS" />
                                    </HBox>
                                </VBox>
                            </StackPane>

                            <VBox spacing="7.0" style="-fx-background-color: -sf-surface-soft; -fx-background-radius: 14; -fx-border-color: -sf-border-soft; -fx-border-radius: 14; -fx-padding: 10;">
                                <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: -sf-heading;" text="Lịch đấu giá" />
                                <HBox alignment="CENTER_LEFT" spacing="7.0">
                                    <Label prefWidth="70.0" style="-fx-text-fill: -sf-text; -fx-font-weight: bold; -fx-font-size: 12px;" text="Bắt đầu" />
                                    <DatePicker fx:id="startDatePicker" prefHeight="31.0" prefWidth="135.0" />
                                    <Spinner fx:id="startHourSpinner" prefHeight="31.0" prefWidth="64.0"><valueFactory><SpinnerValueFactory.IntegerSpinnerValueFactory initialValue="12" max="23" min="0" /></valueFactory></Spinner>
                                    <Label style="-fx-font-size: 12px; -fx-text-fill: -sf-muted;" text="giờ" />
                                    <Spinner fx:id="startMinuteSpinner" prefHeight="31.0" prefWidth="64.0"><valueFactory><SpinnerValueFactory.IntegerSpinnerValueFactory initialValue="0" max="59" min="0" /></valueFactory></Spinner>
                                    <Label style="-fx-font-size: 12px; -fx-text-fill: -sf-muted;" text="phút" />
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="7.0">
                                    <Label prefWidth="70.0" style="-fx-text-fill: -sf-text; -fx-font-weight: bold; -fx-font-size: 12px;" text="Kết thúc" />
                                    <DatePicker fx:id="endDatePicker" prefHeight="31.0" prefWidth="135.0" />
                                    <Spinner fx:id="endHourSpinner" prefHeight="31.0" prefWidth="64.0"><valueFactory><SpinnerValueFactory.IntegerSpinnerValueFactory initialValue="12" max="23" min="0" /></valueFactory></Spinner>
                                    <Label style="-fx-font-size: 12px; -fx-text-fill: -sf-muted;" text="giờ" />
                                    <Spinner fx:id="endMinuteSpinner" prefHeight="31.0" prefWidth="64.0"><valueFactory><SpinnerValueFactory.IntegerSpinnerValueFactory initialValue="0" max="59" min="0" /></valueFactory></Spinner>
                                    <Label style="-fx-font-size: 12px; -fx-text-fill: -sf-muted;" text="phút" />
                                </HBox>
                            </VBox>
                            <!-- KHÔNG còn HBox nút ở đây nữa -->
                        </VBox>
                    </HBox>
                </VBox>
                <!-- ↑ detailFormBox đóng ở đây ↑ -->

                <!-- HBox nút nằm NGOÀI detailFormBox, vẫn trong sf-card -->
                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="viewAuctionButton" managed="false" prefHeight="38.0" prefWidth="180.0" style="-fx-background-color: linear-gradient(to right, #27ae60, #2ecc71);                                    -fx-text-fill: white; -fx-font-weight: bold;                                    -fx-background-radius: 13; -fx-cursor: hand;                                    -fx-effect: dropshadow(gaussian, rgba(46,204,113,0.35), 8, 0.3, 0, 2);" text="▶  Xem phiên đấu giá" visible="false" />
