<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.collections.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="720" prefWidth="1280.0" style="-fx-background-color: linear-gradient(to bottom, #e6f7ff, #ffffff);" stylesheets="@../css/global.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javfxtutorial.hethongdaugia.client.controller.SellerManagementController">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="55.0" prefWidth="737.0" spacing="15" style="-fx-background-color: linear-gradient(to right, #89CFF0, lavender); -fx-padding: 0 15;">
            <ImageView fitHeight="53.0" fitWidth="84.0" pickOnBounds="true" preserveRatio="true">
                <image><Image url="@../../assets/ClassicLogo.png" /></image>
            </ImageView>
            <Label style="-fx-font-size: 18px; -fx-text-fill: linear-gradient(to right, purple, #2f80ed); -fx-font-weight: bold;" text="SnowFox - Quản lý sản phẩm" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="goMenu" onAction="#goMenu" style="-fx-background-color: linear-gradient(to right, #56ccf2, #2f80ed); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 15; -fx-padding: 5 15; -fx-font-size: 12px;" text="Trang chủ" />
        </HBox>
    </top>

    <center>
        <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent;">
            <HBox fillHeight="true" spacing="10" style="-fx-padding: 10; -fx-background-color: transparent;">

                <!-- ==================== DANH SÁCH SẢN PHẨM (TRÁI) ==================== -->
                <VBox prefHeight="619.0" prefWidth="280.0" spacing="8" style="-fx-background-color: #ffffff; -fx-padding: 10; -fx-background-radius: 8; -fx-border-color: #b3c6ff; -fx-border-radius: 8;" HBox.hgrow="NEVER">
                    <Label style="-fx-font-size: 14px; -fx-text-fill: #333366; -fx-font-weight: bold;" text="Danh sách sản phẩm" />
                    <ListView fx:id="productList" prefHeight="508.0" prefWidth="250.0" VBox.vgrow="ALWAYS" />
                    <HBox alignment="CENTER" spacing="10">
                        <Button onAction="#onAddButton" prefWidth="70" style="-fx-background-color: #00A86B; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-font-size: 12px;" text="Thêm" />
                        <Button onAction="#deleteAuction" prefWidth="70" style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-font-size: 12px;" text="Xóa" />
                    </HBox>
                </VBox>

                <!-- ==================== FORM CHI TIẾT (PHẢI) ==================== -->
                <VBox spacing="6" style="-fx-background-color: lavender; -fx-padding: 12; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 4, 0, 0, 1);" HBox.hgrow="ALWAYS">

                    <Label style="-fx-font-size: 14px; -fx-text-fill: #4b0082; -fx-font-weight: bold;" text="Chi tiết sản phẩm" />

                    <!-- Ảnh + nút tải ảnh -->
                    <HBox alignment="CENTER_LEFT" prefHeight="100.0" spacing="10">
                        <ImageView fx:id="Image" fitHeight="80.0" fitWidth="80.0" pickOnBounds="true" preserveRatio="true">
                            <image><Image url="@../../assets/ClassicLogo.png" /></image>
                        </ImageView>
                        <Button fx:id="btupImg" onAction="#clickToChooseImage" style="-fx-background-color: linear-gradient(to right, purple, #2f80ed); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-font-size: 11px; -fx-padding: 5 10;" text="Tải ảnh lên" />
                    </HBox>

                    <!-- Tên + Mô tả -->
                    <TextField fx:id="nameField" prefHeight="34.0" promptText="Tên sản phẩm" style="-fx-border-color: #b3c6ff; -fx-border-radius: 4; -fx-background-radius: 4; -fx-font-size: 12px; -fx-background-color: white;" />
                    <TextArea fx:id="descriptionField" prefHeight="80.0" promptText="Mô tả sản phẩm" style="-fx-border-color: #b3c6ff; -fx-border-radius: 4; -fx-font-size: 12px; -fx-background-color: white;" wrapText="true" />

                    <!-- Giá + Bước giá + Phân loại -->
                    <HBox spacing="8">
                        <TextField fx:id="priceField" prefHeight="27.0" promptText="Giá khởi điểm" style="-fx-border-color: #b3c6ff; -fx-border-radius: 4; -fx-background-radius: 4; -fx-font-size: 12px; -fx-background-color: white;" HBox.hgrow="ALWAYS" />
                        <TextField fx:id="tfstepPrice" prefHeight="27.0" promptText="Bước giá" style="-fx-border-color: #b3c6ff; -fx-border-radius: 4; -fx-background-radius: 4; -fx-font-size: 12px; -fx-background-color: white;" HBox.hgrow="ALWAYS" />
                        <ComboBox fx:id="categoryComboBox" prefHeight="27.0" prefWidth="160.0" promptText="Chọn phân loại" style="-fx-border-color: #b3c6ff; -fx-border-radius: 4; -fx-background-radius: 4; -fx-font-size: 12px; -fx-background-color: white;">
                            <items><FXCollections fx:factory="observableArrayList" /></items>
                        </ComboBox>
                    </HBox>

                    <!-- ==================== ART FIELDS ==================== -->
                    <VBox fx:id="artFields" managed="false" spacing="6" visible="false">
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #e74c3c; -fx-font-weight: bold;" text="🎨 Thông tin Art" />
                        <TextField fx:id="artTitleField" promptText="Tiêu đề tác phẩm (title) - VD: Mùa thu vàng" style="-fx-border-color: #e74c3c; -fx-border-radius: 4; -fx-background-radius: 4; -fx-font-size: 12px; -fx-background-color: white;" />
                        <TextField fx:id="artistField" promptText="Nghệ sĩ (artist) - VD: Nguyễn Văn A" style="-fx-border-color: #e74c3c; -fx-border-radius: 4; -fx-background-radius: 4; -fx-font-size: 12px; -fx-background-color: white;" />
                        <TextField fx:id="yearCreatedField" promptText="Năm sáng tác (yearCreated) - VD: 2023" style="-fx-border-color: #e74c3c; -fx-border-radius: 4; -fx-background-radius: 4; -fx-font-size: 12px; -fx-background-color: white;" />
                    </VBox>

                    <!-- ==================== VEHICLE FIELDS ==================== -->
                    <VBox fx:id="vehicleFields" managed="false" spacing="6" visible="false">
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #f39c12; -fx-font-weight: bold;" text="🚗 Thông tin Vehicle" />
                        <TextField fx:id="licensePlateField" promptText="Biển số (licensePlate) - VD: 51A-123.45" style="-fx-border-color: #f39c12; -fx-border-radius: 4; -fx-background-radius: 4; -fx-font-size: 12px; -fx-background-color: white;" />
                        <TextField fx:id="vehicleYearField" promptText="Năm sản xuất (year) - VD: 2022" style="-fx-border-color: #f39c12; -fx-border-radius: 4; -fx-background-radius: 4; -fx-font-size: 12px; -fx-background-color: white;" />
                        <TextField fx:id="brandVehicleField" promptText="Hãng xe (brand) - VD: Toyota" style="-fx-border-color: #f39c12; -fx-border-radius: 4; -fx-background-radius: 4; -fx-font-size: 12px; -fx-background-color: white;" />
                        <TextField fx:id="colorField" promptText="Màu sắc (color) - VD: Trắng" style="-fx-border-color: #f39c12; -fx-border-radius: 4; -fx-background-radius: 4; -fx-font-size: 12px; -fx-background-color: white;" />
                    </VBox>

                    <!-- ==================== ELECTRONICS FIELDS ==================== -->
                    <VBox fx:id="electronicsFields" managed="false" spacing="6" visible="false">
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #2f80ed; -fx-font-weight: bold;" text="💻 Thông tin Electronics" />
                        <TextField fx:id="brandElecField" promptText="Hãng sản xuất (brand) - VD: Apple" style="-fx-border-color: #2f80ed; -fx-border-radius: 4; -fx-background-radius: 4; -fx-font-size: 12px; -fx-background-color: white;" />
                        <TextField fx:id="modelField" promptText="Dòng máy (model) - VD: MacBook Pro M3" style="-fx-border-color: #2f80ed; -fx-border-radius: 4; -fx-background-radius: 4; -fx-font-size: 12px; -fx-background-color: white;" />
                    </VBox>

                    <!-- Thời gian bắt đầu -->
                    <HBox alignment="CENTER_LEFT" spacing="5">
                        <Label prefWidth="55" style="-fx-text-fill: #333366; -fx-font-weight: bold; -fx-font-size: 11px;" text="Bắt đầu:" />
                        <DatePicker fx:id="startDatePicker" prefWidth="110" style="-fx-font-size: 11px;" />
                        <Spinner fx:id="startHourSpinner" prefWidth="55"><valueFactory><SpinnerValueFactory.IntegerSpinnerValueFactory initialValue="12" max="23" min="0" /></valueFactory></Spinner>
                        <Label style="-fx-font-size: 11px;" text="Giờ" />
                        <Spinner fx:id="startMinuteSpinner" prefWidth="55"><valueFactory><SpinnerValueFactory.IntegerSpinnerValueFactory initialValue="0" max="59" min="0" /></valueFactory></Spinner>
                        <Label style="-fx-font-size: 11px;" text="Phút" />
                    </HBox>

                    <!-- Thời gian kết thúc -->
                    <HBox alignment="CENTER_LEFT" spacing="5">
                        <Label prefWidth="55" style="-fx-text-fill: #333366; -fx-font-weight: bold; -fx-font-size: 11px;" text="Kết thúc:" />
                        <DatePicker fx:id="endDatePicker" prefWidth="110" style="-fx-font-size: 11px;" />
                        <Spinner fx:id="endHourSpinner" prefWidth="55"><valueFactory><SpinnerValueFactory.IntegerSpinnerValueFactory initialValue="12" max="23" min="0" /></valueFactory></Spinner>
                        <Label style="-fx-font-size: 11px;" text="Giờ" />
                        <Spinner fx:id="endMinuteSpinner" prefWidth="55"><valueFactory><SpinnerValueFactory.IntegerSpinnerValueFactory initialValue="0" max="59" min="0" /></valueFactory></Spinner>
                        <Label style="-fx-font-size: 11px;" text="Phút" />
                    </HBox>

                    <!-- Nút Lưu -->
                    <HBox alignment="CENTER">
                        <Button fx:id="saveButton" onAction="#onSaveButton" prefWidth="100" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 5 0; -fx-font-size: 12px;" text="Sửa" />
                    </HBox>
                </VBox>

            </HBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox alignment="CENTER" style="-fx-background-color: #b3c6ff; -fx-padding: 5;">
            <Label style="-fx-text-fill: white; -fx-font-size: 11px;" text="© 2026 SnowFox - Studio SnowFlake" />
        </HBox>
    </bottom>
</BorderPane>
