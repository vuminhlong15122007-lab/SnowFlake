<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.collections.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane maxHeight="720.0" maxWidth="1280.0" minHeight="720.0" minWidth="1280.0" prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: linear-gradient(to bottom right, #eef8ff, #ffffff 45%, #f4efff);" stylesheets="@../css/global.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javfxtutorial.hethongdaugia.client.controller.SellerManagementController">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="62.0" prefWidth="1280.0" spacing="14.0" style="-fx-background-color: linear-gradient(to right, #f8fcff, #ffffff, #eef4ff); -fx-border-color: #c9ddff; -fx-border-width: 0 0 1 0; -fx-effect: dropshadow(gaussian, rgba(51,51,102,0.12), 12, 0.2, 0, 2);">
            <padding>
                <Insets bottom="8.0" left="20.0" right="20.0" top="8.0" />
            </padding>

            <ImageView fitHeight="46.0" fitWidth="46.0" pickOnBounds="true" preserveRatio="true">
                <image><Image url="@../../assets/ClassicLogo.png" /></image>
            </ImageView>

            <VBox alignment="CENTER_LEFT" spacing="1.0">
                <Label style="-fx-font-size: 21px; -fx-font-weight: bold; -fx-text-fill: linear-gradient(to right, #7b2ff7, #2f80ed);" text="SnowFox Seller" />
                <Label style="-fx-font-size: 12px; -fx-text-fill: #5d6b89; -fx-font-weight: bold;" text="Quản lý sản phẩm và phiên đấu giá của bạn" />
            </VBox>

            <Region HBox.hgrow="ALWAYS" />

            <!-- Thêm vào HBox top, trước nút Trang chủ -->
            <StackPane onMouseClicked="#openNotifications" style="-fx-cursor: hand;">
                <Label text="🔔" style="-fx-font-size: 26px;" />
                <Label fx:id="badgeLabel" text="0"
                       style="-fx-background-color: red; -fx-text-fill: white;
                  -fx-background-radius: 10; -fx-font-size: 10px;
                  -fx-padding: 1 5; -fx-font-weight: bold;"
                       StackPane.alignment="TOP_RIGHT" translateX="8" translateY="-4"/>
            </StackPane>

            <Button fx:id="goMenu" onAction="#goMenu" prefHeight="34.0" prefWidth="105.0" style="-fx-background-color: linear-gradient(to right, #56ccf2, #2f80ed); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 18; -fx-cursor: hand;" text="Trang chủ" />
        </HBox>
    </top>

    <center>
        <HBox prefHeight="632.0" prefWidth="1280.0" spacing="14.0" style="-fx-padding: 14 16 12 16;">

            <VBox maxWidth="330.0" prefWidth="330.0" spacing="10.0" style="-fx-background-color: rgba(255,255,255,0.92); -fx-background-radius: 18; -fx-border-color: #c9ddff; -fx-border-radius: 18; -fx-effect: dropshadow(gaussian, rgba(47,128,237,0.13), 14, 0.18, 0, 3);">
                <padding>
                    <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                </padding>

                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <VBox alignment="CENTER_LEFT" spacing="1.0">
                        <Label style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #26355f;" text="Kho sản phẩm" />
                        <Label style="-fx-font-size: 11px; -fx-text-fill: #6c7894;" text="Chọn sản phẩm để sửa hoặc xóa" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                </HBox>

                <ListView fx:id="productList" prefHeight="500.0" prefWidth="306.0" style="-fx-background-color: transparent; -fx-control-inner-background: transparent; -fx-background-insets: 0; -fx-padding: 2;" VBox.vgrow="ALWAYS" />

                <HBox alignment="CENTER" spacing="10.0">
                    <Button onAction="#onAddButton" prefHeight="36.0" prefWidth="134.0" style="-fx-background-color: linear-gradient(to right, #16c784, #00a86b); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 12; -fx-cursor: hand;" text="+ Thêm" />
                    <Button onAction="#deleteAuction" prefHeight="36.0" prefWidth="134.0" style="-fx-background-color: linear-gradient(to right, #ff6b6b, #dc3545); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 12; -fx-cursor: hand;" text="Xóa" />
                </HBox>
            </VBox>

            <VBox spacing="10.0" style="-fx-background-color: rgba(255,255,255,0.92); -fx-background-radius: 18; -fx-border-color: #c9ddff; -fx-border-radius: 18; -fx-effect: dropshadow(gaussian, rgba(51,51,102,0.12), 14, 0.18, 0, 3);" HBox.hgrow="ALWAYS">
                <padding>
                    <Insets bottom="12.0" left="14.0" right="14.0" top="12.0" />
                </padding>

                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <VBox alignment="CENTER_LEFT" spacing="1.0">
                        <Label style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: linear-gradient(to right, #7b2ff7, #2f80ed);" text="Chi tiết phiên đấu giá" />
                        <Label style="-fx-font-size: 11px; -fx-text-fill: #6c7894;" text="Nhập thông tin sản phẩm, giá và thời gian mở phiên" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                </HBox>

                <HBox spacing="14.0" VBox.vgrow="ALWAYS">

                    <VBox maxWidth="244.0" prefWidth="244.0" spacing="10.0" style="-fx-background-color: linear-gradient(to bottom, #f5faff, #ffffff); -fx-background-radius: 16; -fx-border-color: #d8e8ff; -fx-border-radius: 16; -fx-padding: 12;">
                        <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #26355f;" text="Ảnh sản phẩm" />

                        <StackPane prefHeight="238.0" prefWidth="220.0" style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-color: #d8e8ff; -fx-border-radius: 16; -fx-effect: dropshadow(gaussian, rgba(47,128,237,0.10), 10, 0.15, 0, 2);">
                            <ImageView fx:id="Image" fitHeight="214.0" fitWidth="214.0" pickOnBounds="true" preserveRatio="true">
                                <image><Image url="@../../assets/ClassicLogo.png" /></image>
                            </ImageView>
                        </StackPane>

                        <Button fx:id="btupImg" maxWidth="Infinity" onAction="#clickToChooseImage" prefHeight="36.0" style="-fx-background-color: linear-gradient(to right, #7b2ff7, #2f80ed); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 12; -fx-cursor: hand;" text="Tải ảnh lên" />

                        <VBox spacing="6.0" style="-fx-background-color: #f8fbff; -fx-background-radius: 14; -fx-padding: 10; -fx-border-color: #e1ecff; -fx-border-radius: 14;">
                            <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #4b5f91;" text="Gợi ý nhập liệu" />
                            <Label style="-fx-font-size: 11px; -fx-text-fill: #6c7894;" text="• Giá và bước giá nhập số" />
                            <Label style="-fx-font-size: 11px; -fx-text-fill: #6c7894;" text="• Chọn phân loại để mở form riêng" />
                            <Label style="-fx-font-size: 11px; -fx-text-fill: #6c7894;" text="• Thời gian kết thúc phải sau bắt đầu" />
                        </VBox>

                        <Region VBox.vgrow="ALWAYS" />
                    </VBox>

                    <VBox spacing="8.0" HBox.hgrow="ALWAYS">

                        <TextField fx:id="nameField" prefHeight="34.0" promptText="Tên sản phẩm" style="-fx-background-color: #ffffff; -fx-background-radius: 10; -fx-border-color: #d8e8ff; -fx-border-radius: 10; -fx-font-size: 13px; -fx-padding: 0 12;" />

                        <TextArea fx:id="descriptionField" prefHeight="72.0" promptText="Mô tả sản phẩm" style="-fx-background-color: #ffffff; -fx-background-radius: 10; -fx-border-color: #d8e8ff; -fx-border-radius: 10; -fx-font-size: 13px;" wrapText="true" />

                        <HBox spacing="8.0">
                            <TextField fx:id="priceField" prefHeight="34.0" promptText="Giá khởi điểm / giá hiện tại" style="-fx-background-color: #ffffff; -fx-background-radius: 10; -fx-border-color: #d8e8ff; -fx-border-radius: 10; -fx-font-size: 13px; -fx-padding: 0 12;" HBox.hgrow="ALWAYS" />
                            <TextField fx:id="tfstepPrice" prefHeight="34.0" promptText="Bước giá" style="-fx-background-color: #ffffff; -fx-background-radius: 10; -fx-border-color: #d8e8ff; -fx-border-radius: 10; -fx-font-size: 13px; -fx-padding: 0 12;" HBox.hgrow="ALWAYS" />
                            <ComboBox fx:id="categoryComboBox" prefHeight="34.0" prefWidth="178.0" promptText="Phân loại" style="-fx-background-color: #ffffff; -fx-background-radius: 10; -fx-border-color: #d8e8ff; -fx-border-radius: 10; -fx-font-size: 13px;">
                                <items><FXCollections fx:factory="observableArrayList" /></items>
                            </ComboBox>
                        </HBox>

                        <StackPane maxHeight="126.0" minHeight="126.0" prefHeight="126.0">
                            <VBox alignment="CENTER" mouseTransparent="true" style="-fx-background-color: #f8fbff; -fx-background-radius: 14; -fx-border-color: #e1ecff; -fx-border-radius: 14; -fx-padding: 10;">
                                <Label style="-fx-font-size: 12px; -fx-text-fill: #7b879f; -fx-font-weight: bold;" text="Chọn ART / VEHICLE / ELECTRONICS để nhập thông tin riêng" />
                            </VBox>

                            <VBox fx:id="artFields" managed="false" spacing="7.0" style="-fx-background-color: #fff8fb; -fx-background-radius: 14; -fx-border-color: #f3bad0; -fx-border-radius: 14; -fx-padding: 10;" visible="false">
                                <Label style="-fx-font-size: 13px; -fx-text-fill: #c2185b; -fx-font-weight: bold;" text="Thông tin tác phẩm nghệ thuật" />
                                <HBox spacing="8.0">
                                    <TextField fx:id="artTitleField" promptText="Tiêu đề tác phẩm" style="-fx-background-color: white; -fx-background-radius: 9; -fx-border-color: #f3bad0; -fx-border-radius: 9;" HBox.hgrow="ALWAYS" />
                                    <TextField fx:id="artistField" promptText="Nghệ sĩ" style="-fx-background-color: white; -fx-background-radius: 9; -fx-border-color: #f3bad0; -fx-border-radius: 9;" HBox.hgrow="ALWAYS" />
                                </HBox>
                                <TextField fx:id="yearCreatedField" promptText="Năm sáng tác" style="-fx-background-color: white; -fx-background-radius: 9; -fx-border-color: #f3bad0; -fx-border-radius: 9;" />
                            </VBox>

                            <VBox fx:id="vehicleFields" managed="false" spacing="7.0" style="-fx-background-color: #fffaf0; -fx-background-radius: 14; -fx-border-color: #ffd88a; -fx-border-radius: 14; -fx-padding: 10;" visible="false">
                                <Label style="-fx-font-size: 13px; -fx-text-fill: #b36b00; -fx-font-weight: bold;" text="Thông tin phương tiện" />
                                <HBox spacing="8.0">
                                    <TextField fx:id="licensePlateField" promptText="Biển số" style="-fx-background-color: white; -fx-background-radius: 9; -fx-border-color: #ffd88a; -fx-border-radius: 9;" HBox.hgrow="ALWAYS" />
                                    <TextField fx:id="vehicleYearField" promptText="Năm sản xuất" style="-fx-background-color: white; -fx-background-radius: 9; -fx-border-color: #ffd88a; -fx-border-radius: 9;" HBox.hgrow="ALWAYS" />
                                </HBox>
                                <HBox spacing="8.0">
                                    <TextField fx:id="brandVehicleField" promptText="Hãng xe" style="-fx-background-color: white; -fx-background-radius: 9; -fx-border-color: #ffd88a; -fx-border-radius: 9;" HBox.hgrow="ALWAYS" />
                                    <TextField fx:id="colorField" promptText="Màu sắc" style="-fx-background-color: white; -fx-background-radius: 9; -fx-border-color: #ffd88a; -fx-border-radius: 9;" HBox.hgrow="ALWAYS" />
                                </HBox>
                            </VBox>

                            <VBox fx:id="electronicsFields" managed="false" spacing="7.0" style="-fx-background-color: #f2f8ff; -fx-background-radius: 14; -fx-border-color: #a7d4ff; -fx-border-radius: 14; -fx-padding: 10;" visible="false">
                                <Label style="-fx-font-size: 13px; -fx-text-fill: #2f80ed; -fx-font-weight: bold;" text="Thông tin thiết bị điện tử" />
                                <HBox spacing="8.0">
                                    <TextField fx:id="brandElecField" promptText="Hãng sản xuất" style="-fx-background-color: white; -fx-background-radius: 9; -fx-border-color: #a7d4ff; -fx-border-radius: 9;" HBox.hgrow="ALWAYS" />
                                    <TextField fx:id="modelField" promptText="Dòng máy / model" style="-fx-background-color: white; -fx-background-radius: 9; -fx-border-color: #a7d4ff; -fx-border-radius: 9;" HBox.hgrow="ALWAYS" />
                                </HBox>
                            </VBox>
                        </StackPane>

                        <VBox spacing="7.0" style="-fx-background-color: #f8fbff; -fx-background-radius: 14; -fx-border-color: #e1ecff; -fx-border-radius: 14; -fx-padding: 10;">
                            <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #26355f;" text="Lịch đấu giá" />

                            <HBox alignment="CENTER_LEFT" spacing="7.0">
                                <Label prefWidth="70.0" style="-fx-text-fill: #4b5f91; -fx-font-weight: bold; -fx-font-size: 12px;" text="Bắt đầu" />
                                <DatePicker fx:id="startDatePicker" prefHeight="31.0" prefWidth="135.0" />
                                <Spinner fx:id="startHourSpinner" prefHeight="31.0" prefWidth="64.0"><valueFactory><SpinnerValueFactory.IntegerSpinnerValueFactory initialValue="12" max="23" min="0" /></valueFactory></Spinner>
                                <Label style="-fx-font-size: 12px; -fx-text-fill: #6c7894;" text="giờ" />
                                <Spinner fx:id="startMinuteSpinner" prefHeight="31.0" prefWidth="64.0"><valueFactory><SpinnerValueFactory.IntegerSpinnerValueFactory initialValue="0" max="59" min="0" /></valueFactory></Spinner>
                                <Label style="-fx-font-size: 12px; -fx-text-fill: #6c7894;" text="phút" />
                            </HBox>

                            <HBox alignment="CENTER_LEFT" spacing="7.0">
                                <Label prefWidth="70.0" style="-fx-text-fill: #4b5f91; -fx-font-weight: bold; -fx-font-size: 12px;" text="Kết thúc" />
                                <DatePicker fx:id="endDatePicker" prefHeight="31.0" prefWidth="135.0" />
                                <Spinner fx:id="endHourSpinner" prefHeight="31.0" prefWidth="64.0"><valueFactory><SpinnerValueFactory.IntegerSpinnerValueFactory initialValue="12" max="23" min="0" /></valueFactory></Spinner>
                                <Label style="-fx-font-size: 12px; -fx-text-fill: #6c7894;" text="giờ" />
                                <Spinner fx:id="endMinuteSpinner" prefHeight="31.0" prefWidth="64.0"><valueFactory><SpinnerValueFactory.IntegerSpinnerValueFactory initialValue="0" max="59" min="0" /></valueFactory></Spinner>
                                <Label style="-fx-font-size: 12px; -fx-text-fill: #6c7894;" text="phút" />
                            </HBox>
                        </VBox>

                        <HBox alignment="CENTER_RIGHT" spacing="10.0">
                            <Region HBox.hgrow="ALWAYS" />
                            <Button fx:id="saveButton" onAction="#onSaveButton" prefHeight="38.0" prefWidth="132.0" style="-fx-background-color: linear-gradient(to right, #56ccf2, #2f80ed); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 13; -fx-cursor: hand;" text="Lưu" />
                        </HBox>
                    </VBox>
                </HBox>
            </VBox>
        </HBox>
    </center>

    <bottom>
        <HBox alignment="CENTER" prefHeight="26.0" style="-fx-background-color: linear-gradient(to right, #b3c6ff, #89CFF0);">
            <Label style="-fx-text-fill: white; -fx-font-size: 11px; -fx-font-weight: bold;" text="© 2026 SnowFox - Studio SnowFlake" />
        </HBox>
    </bottom>
</BorderPane>
