<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="180.0" prefWidth="780.0" style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-radius: 12; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 8, 0, 0, 2);" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javfxtutorial.hethongdaugia.client.controller.AuctionSessionController">

    <HBox alignment="CENTER_LEFT" spacing="20.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0">

        <!-- ==================== ẢNH SẢN PHẨM ==================== -->
        <StackPane prefHeight="150.0" prefWidth="150.0" style="-fx-background-color: #f8f9fa; -fx-background-radius: 12;">
            <ImageView fx:id="productImage" fitHeight="120.0" fitWidth="120.0" pickOnBounds="true" preserveRatio="true" />
        </StackPane>

        <!-- ==================== THÔNG TIN CHÍNH ==================== -->
        <VBox prefHeight="147.0" prefWidth="300.0" spacing="10.0" HBox.hgrow="ALWAYS">
            <Label fx:id="lbCategory" text="Loại sản phẩm" />

            <!-- Tên sản phẩm -->
            <Label fx:id="lbProductName" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Toyota Camry 2022" />

            <!-- Chi tiết sản phẩm -->
            <HBox spacing="5.0">
                <Label style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;" text="Người bán:  " />
                <Label fx:id="lbSellerName" prefHeight="20.0" prefWidth="230.0" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;" text="Tên" />
            </HBox>

            <!-- Giá cuối -->
            <HBox spacing="5.0">
                <Label prefHeight="51.0" prefWidth="53.0" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;" text="Giá cuối:" />
                <Label fx:id="lbPrice" prefHeight="27.0" prefWidth="266.0" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #e74c3c;" text="850,000,000 VND" />
            </HBox>

            <!-- Người thắng -->
            <HBox spacing="5.0">
                <Label style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;" text="Người thắng:" />
                <Label fx:id="lbWinner" prefHeight="20.0" prefWidth="241.0" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #27ae60;" text="user_abc" />
            </HBox>
        </VBox>

        <!-- ==================== KHOẢNG TRỐNG ==================== -->
        <Pane prefHeight="147.0" prefWidth="50.0" />

        <!-- ==================== NÚT HÀNH ĐỘNG ==================== -->
        <VBox alignment="CENTER" prefWidth="140.0" spacing="10.0">
            <Button fx:id="actionButton" alignment="CENTER" onAction="#BtAuction" prefHeight="40.0" prefWidth="140.0" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-background-radius: 25;" text="ĐÃ KẾT THÚC" />
        </VBox>

    </HBox>
      <!-- Tag trạng thái ĐÃ KẾT THÚC (màu xám) -->
      <Label fx:id="statusBadge" layoutY="3.0" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-size: 10px; -fx-font-weight: bold; -fx-padding: 4 10; -fx-background-radius: 8;" text="ĐÃ KẾT THÚC" />
</AnchorPane>
