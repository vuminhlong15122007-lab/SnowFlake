<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: linear-gradient(to bottom, #e6f7ff, #ffffff);" stylesheets="@../css/global.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javfxtutorial.hethongdaugia.client.controller.AuctionController">

    <!-- ==================== HEADER ==================== -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="5" style="-fx-background-color: linear-gradient(to right, #89CFF0,lavender); -fx-padding: 15;">
            <ImageView fitHeight="50.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true">
                <image><Image url="@../../assets/Logo.png" /></image>
            </ImageView>
            <Label prefHeight="32.0" prefWidth="186.0" style="-fx-font-size: 22px; -fx-text-fill: linear-gradient(to right, purple, #2f80ed); -fx-font-weight: bold;" text="SnowFox Auction" />
            <Region prefHeight="50.0" prefWidth="585.0" HBox.hgrow="ALWAYS" />
            <HBox alignment="CENTER_LEFT" prefHeight="42.0" prefWidth="392.0" spacing="8.0" style="-fx-background-color: rgba(255,255,255,0.92); -fx-background-radius: 24; -fx-border-color: rgba(47,128,237,0.20); -fx-border-radius: 24; -fx-padding: 0 8 0 16; -fx-effect: dropshadow(gaussian, rgba(137,207,240,0.25), 12, 0, 0, 2);">
                <Label style="-fx-font-size: 15px; -fx-text-fill: #2f80ed;" text="🔍" />
                <TextField fx:id="searchField" promptText="Tìm kiếm phiên đấu giá..." style="-fx-background-color: transparent; -fx-font-size: 13px; -fx-text-fill: #26364d; -fx-prompt-text-fill: #7d91b3;" HBox.hgrow="ALWAYS" />
                <Button prefHeight="32.0" prefWidth="86.0" style="-fx-background-color: linear-gradient(to right, #56ccf2, #2f80ed); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 18; -fx-cursor: hand;" text="Search" />
            </HBox>
        </HBox>
    </top>

    <!-- ==================== MENU TRÁI ==================== -->
    <left>
        <VBox prefHeight="606.0" prefWidth="263.0" spacing="5" style="-fx-background-color: #f0f8ff; -fx-padding: 15; -fx-pref-width: 200;">
            <VBox spacing="8.0" style="-fx-background-color: rgba(255,255,255,0.72); -fx-background-radius: 22; -fx-border-color: rgba(137,207,240,0.35); -fx-border-radius: 22; -fx-padding: 14; -fx-effect: dropshadow(gaussian, rgba(47,128,237,0.10), 12, 0, 0, 3);">
                <Label alignment="CENTER" prefHeight="16.0" prefWidth="138.0" style="-fx-font-size: 11px; -fx-text-fill: #7d91b3; -fx-font-weight: bold;" text="BỘ LỌC TRẠNG THÁI" />
                <Button fx:id="btnAll" prefHeight="42.0" prefWidth="210.0" style="-fx-background-color: linear-gradient(to right, #56ccf2, #2f80ed); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 14; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 16; -fx-effect: dropshadow(gaussian, rgba(47,128,237,0.25), 10, 0, 0, 2);" text="📋   Tất cả phiên" />
                <Button fx:id="btnUpcoming" prefHeight="42.0" prefWidth="210.0" style="-fx-background-color: white; -fx-text-fill: #667085; -fx-font-weight: bold; -fx-background-radius: 14; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 16; -fx-border-color: #dbeafe; -fx-border-radius: 14;" text="🕐   Sắp diễn ra" />
                <Button fx:id="btnRunning" prefHeight="42.0" prefWidth="210.0" style="-fx-background-color: white; -fx-text-fill: #667085; -fx-font-weight: bold; -fx-background-radius: 14; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 16; -fx-border-color: #dbeafe; -fx-border-radius: 14;" text="🔴   Đang diễn ra" />
                <Button fx:id="btnEnded" prefHeight="42.0" prefWidth="210.0" style="-fx-background-color: white; -fx-text-fill: #667085; -fx-font-weight: bold; -fx-background-radius: 14; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 16; -fx-border-color: #dbeafe; -fx-border-radius: 14;" text="✅   Đã kết thúc" />
            </VBox>

            <VBox spacing="8.0" style="-fx-background-color: rgba(255,255,255,0.72); -fx-background-radius: 22; -fx-border-color: rgba(137,207,240,0.35); -fx-border-radius: 22; -fx-padding: 14; -fx-effect: dropshadow(gaussian, rgba(47,128,237,0.09), 12, 0, 0, 3);">
                <Label alignment="CENTER" prefHeight="16.0" prefWidth="153.0" style="-fx-font-size: 11px; -fx-text-fill: #7d91b3; -fx-font-weight: bold;" text="LOẠI SẢN PHẨM" />
                <ComboBox fx:id="categoryFilter" prefHeight="40.0" prefWidth="210.0" promptText="Tất cả loại" style="-fx-background-color: white; -fx-border-color: #dbeafe; -fx-border-radius: 14; -fx-background-radius: 14; -fx-padding: 2 8 2 8;" />
            </VBox>

            <VBox prefHeight="234.0" prefWidth="184.0" spacing="8.0" style="-fx-background-color: rgba(255,255,255,0.72); -fx-background-radius: 22; -fx-border-color: rgba(137,207,240,0.35); -fx-border-radius: 22; -fx-padding: 14; -fx-effect: dropshadow(gaussian, rgba(47,128,237,0.09), 12, 0, 0, 3);">
                <Label alignment="CENTER" prefHeight="16.0" prefWidth="140.0" style="-fx-font-size: 11px; -fx-text-fill: #7d91b3; -fx-font-weight: bold;" text="ĐIỀU HƯỚNG" />
                <Button fx:id="btnHome" alignment="CENTER" contentDisplay="TOP" nodeOrientation="LEFT_TO_RIGHT" onAction="#btnHome" prefHeight="40.0" prefWidth="140.0" style="-fx-background-color: white; -fx-text-fill: #475467; -fx-font-weight: bold; -fx-alignment: CENTER-LEFT; -fx-background-radius: 14; -fx-padding: 0 0 0 16; -fx-border-color: #dbeafe; -fx-border-radius: 14;" text="Trang chủ" />
                <Button fx:id="btnmanageProducts" onAction="#manageProducts" prefHeight="39.0" prefWidth="210.0" style="-fx-background-color: white; -fx-text-fill: #475467; -fx-font-weight: bold; -fx-background-radius: 14; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 16; -fx-border-color: #dbeafe; -fx-border-radius: 14;" text="Quản lý sản phẩm" />
                <Button fx:id="btnprofile" onAction="#goToProfile" prefHeight="39.0" prefWidth="210.0" style="-fx-background-color: white; -fx-text-fill: #475467; -fx-font-weight: bold; -fx-background-radius: 14; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 16; -fx-border-color: #dbeafe; -fx-border-radius: 14;" text="Thông tin User" />
                <Button fx:id="logOut1" onAction="#logOut1" prefHeight="39.0" prefWidth="210.0" style="-fx-background-color: #fff5f5; -fx-text-fill: #e74c3c; -fx-font-weight: bold; -fx-background-radius: 14; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 16; -fx-border-color: #ffd8d8; -fx-border-radius: 14;" text="Đăng xuất" />
            </VBox>

            <Region VBox.vgrow="ALWAYS" />
        </VBox>
    </left>

    <!-- ==================== NỘI DUNG CHÍNH ==================== -->
    <center>
        <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-padding: 0;">
            <VBox prefHeight="606.0" prefWidth="1051.0" spacing="15" style="-fx-padding: 18 22 14 22; -fx-background-color: white;">

                <!-- Tiêu đề + Kết quả -->
                <HBox alignment="CENTER_LEFT">
                    <Label fx:id="sectionTitle" style="-fx-font-size: 20px; -fx-text-fill: #333366; -fx-font-weight: bold;" text="📋  TẤT CẢ PHIÊN ĐẤU GIÁ" />
                    <Region HBox.hgrow="ALWAYS" />
                </HBox>

                <!-- ==================== DANH SÁCH PHIÊN ĐẤU GIÁ ==================== -->
                <StackPane style="-fx-background-color: rgba(255,255,255,0.68); -fx-background-radius: 30; -fx-border-color: rgba(137,207,240,0.42); -fx-border-radius: 30; -fx-padding: 13; -fx-effect: dropshadow(gaussian, rgba(47,128,237,0.10), 16, 0, 0, 4);" VBox.vgrow="ALWAYS">
                    <ListView fx:id="featuredProductList" style="-fx-background-color: transparent; -fx-control-inner-background: transparent; -fx-background-insets: 0; -fx-padding: 0;" />
                </StackPane>

            </VBox>
        </ScrollPane>
    </center>

    <!-- ==================== FOOTER ==================== -->
    <bottom>
        <HBox alignment="CENTER" style="-fx-background-color: linear-gradient(to right, #FFF0F5, #B3E5FC); -fx-padding: 8;">
            <Label style="-fx-font-size: 12px; -fx-text-fill: #902a2a;" text="© 2026 SnowFox - Studio SnowFlake" />
        </HBox>
    </bottom>
</BorderPane>
