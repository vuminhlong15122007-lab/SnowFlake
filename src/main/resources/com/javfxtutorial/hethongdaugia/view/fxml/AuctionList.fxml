<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: linear-gradient(to bottom, #e6f7ff, #ffffff);" stylesheets="@../css/global.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javfxtutorial.hethongdaugia.client.controller.AuctionController">

    <!-- ==================== HEADER ==================== -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="5" style="-fx-background-color: linear-gradient(to right, #89CFF0,lavender); -fx-padding: 15;">
            <ImageView fitHeight="50.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true">
                <image><Image url="@../../assets/Logo.png" /></image>
            </ImageView>
            <Label prefHeight="32.0" prefWidth="186.0" style="-fx-font-size: 22px; -fx-text-fill: linear-gradient(to right, purple, #2f80ed); -fx-font-weight: bold;" text="SnowFox Auction" />
            <Region prefHeight="50.0" prefWidth="585.0" HBox.hgrow="ALWAYS" />
            <TextField fx:id="searchField" prefWidth="250" promptText="🔍  Tìm kiếm phiên đấu giá..." style="-fx-background-color: #ffffff; -fx-background-radius: 20; -fx-border-radius: 20; -fx-border-color: #dcdde1; -fx-padding: 8;" />
            <Button style="-fx-background-color: #2f80ed; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 8 20;" text="🔍 Search" />
        </HBox>
    </top>

    <!-- ==================== MENU TRÁI ==================== -->
    <left>
        <VBox spacing="5" style="-fx-background-color: #f0f8ff; -fx-padding: 15; -fx-pref-width: 200;">
            <Label style="-fx-font-size: 16px; -fx-text-fill: #333366; -fx-font-weight: bold; -fx-padding: 0 0 10 0;" text="Trạng thái" />

            <Button fx:id="btnAll" prefHeight="40.0" prefWidth="170.0" style="-fx-background-color: linear-gradient(to right, #56ccf2, #2f80ed); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15;" text="📋  Tất cả" />
            <Button fx:id="btnUpcoming" prefHeight="40.0" prefWidth="170.0" style="-fx-background-color: white; -fx-text-fill: #7f8c8d; -fx-font-weight: bold; -fx-background-radius: 8; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-border-color: #dcdde1; -fx-border-radius: 8;" text="🕐  Sắp diễn ra" />
            <Button fx:id="btnRunning" prefHeight="40.0" prefWidth="170.0" style="-fx-background-color: white; -fx-text-fill: #7f8c8d; -fx-font-weight: bold; -fx-background-radius: 8; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-border-color: #dcdde1; -fx-border-radius: 8;" text="🔴  Đang diễn ra" />
            <Button fx:id="btnEnded" prefHeight="40.0" prefWidth="170.0" style="-fx-background-color: white; -fx-text-fill: #7f8c8d; -fx-font-weight: bold; -fx-background-radius: 8; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-border-color: #dcdde1; -fx-border-radius: 8;" text="✅  Đã kết thúc" />

            <Separator style="-fx-padding: 10 0;" />

            <Label style="-fx-font-size: 16px; -fx-text-fill: #333366; -fx-font-weight: bold; -fx-padding: 0 0 10 0;" text="Loại sản phẩm" />

            <ComboBox fx:id="categoryFilter" prefWidth="170.0" promptText="Tất cả loại " style="-fx-background-color: white; -fx-border-color: #dcdde1; -fx-border-radius: 8; -fx-background-radius: 8;" />

            <Separator style="-fx-padding: 10 0;" />

            <!-- Menu điều hướng -->
            <Button fx:id="btnHome" onAction="#btnHome" prefHeight="40.0" prefWidth="170.0" style="-fx-background-color: white; -fx-text-fill: #7f8c8d; -fx-font-weight: bold; -fx-background-radius: 8; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-border-color: #dcdde1; -fx-border-radius: 8;" text="🏠  Trang chủ" />
            <Button fx:id="btnmanageProducts" onAction="#manageProducts" prefHeight="40.0" prefWidth="170.0" style="-fx-background-color: white; -fx-text-fill: #7f8c8d; -fx-font-weight: bold; -fx-background-radius: 8; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-border-color: #dcdde1; -fx-border-radius: 8;" text="📦  Quản lý sản phẩm" />
            <Button fx:id="btnprofile" onAction="#goToProfile" prefHeight="40.0" prefWidth="170.0" style="-fx-background-color: white; -fx-text-fill: #7f8c8d; -fx-font-weight: bold; -fx-background-radius: 8; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-border-color: #dcdde1; -fx-border-radius: 8;" text="👤  Thông tin người dùng" />
            <Button fx:id="logOut1" onAction="#logOut1" prefHeight="40.0" prefWidth="170.0" style="-fx-background-color: white; -fx-text-fill: #e74c3c; -fx-font-weight: bold; -fx-background-radius: 8; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-border-color: #dcdde1; -fx-border-radius: 8;" text="🚪  Đăng xuất" />
        </VBox>
    </left>

    <!-- ==================== NỘI DUNG CHÍNH ==================== -->
    <center>
        <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-padding: 0;">
            <VBox spacing="15" style="-fx-padding: 20;">

                <!-- Tiêu đề + Kết quả -->
                <HBox alignment="CENTER_LEFT">
                    <Label fx:id="sectionTitle" style="-fx-font-size: 20px; -fx-text-fill: #333366; -fx-font-weight: bold;" text="📋  TẤT CẢ PHIÊN ĐẤU GIÁ" />
                    <Region HBox.hgrow="ALWAYS" />
                </HBox>

                <!-- ==================== DANH SÁCH PHIÊN ĐẤU GIÁ ==================== -->
                <ListView fx:id="featuredProductList" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS" />

            </VBox>
        </ScrollPane>
    </center>

    <!-- ==================== FOOTER ==================== -->
    <bottom>
        <HBox alignment="CENTER" style="-fx-background-color: linear-gradient(to right, #FFF0F5, #B3E5FC); -fx-padding: 8;">
            <Label style="-fx-font-size: 12px; -fx-text-fill: #902a2a;" text="© 2026 SnowFox - Studio SnowFlake" />
        </HBox>
    </bottom>
</BorderPane>
