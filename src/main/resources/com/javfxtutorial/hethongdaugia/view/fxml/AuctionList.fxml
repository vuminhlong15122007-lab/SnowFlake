<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="720.0" prefWidth="1280.0" styleClass="sf-page" stylesheets="@../css/global.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javfxtutorial.hethongdaugia.client.controller.AuctionListController">

    <!-- ==================== HEADER ==================== -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="76.0" prefWidth="1280.0" spacing="5" styleClass="sf-header">
            <ImageView fitHeight="50.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true">
                <image><Image url="@../../assets/Logo.png" /></image>
            </ImageView>
            <Label prefHeight="32.0" prefWidth="186.0" styleClass="sf-title" text="SnowFox" />
            <Region prefHeight="50.0" prefWidth="585.0" HBox.hgrow="ALWAYS" />
            <HBox alignment="CENTER_LEFT" prefHeight="42.0" prefWidth="392.0" spacing="8.0" styleClass="sf-search-box">
                <Label style="-fx-font-size: 15px; -fx-text-fill: -sf-accent;" text="🔍" />
                <TextField fx:id="searchField" promptText="Tìm kiếm phiên đấu giá..." style="-fx-background-color: transparent; -fx-font-size: 13px; -fx-text-fill: -sf-heading; -fx-prompt-text-fill: -sf-muted;" HBox.hgrow="ALWAYS" />
                <Button prefHeight="32.0" prefWidth="86.0" styleClass="sf-btn-primary" text="Search" />
            </HBox>
        </HBox>
    </top>

    <!-- ==================== MENU TRÁI ==================== -->
    <left>
        <VBox prefHeight="606.0" prefWidth="263.0" spacing="5" styleClass="sf-sidebar">
            <VBox alignment="CENTER" spacing="8.0" styleClass="sf-card-soft">
                <Label alignment="CENTER" prefHeight="16.0" prefWidth="138.0" style="-fx-font-size: 11px; -fx-text-fill: -sf-muted; -fx-font-weight: bold;" text="BỘ LỌC TRẠNG THÁI" />
                <Button fx:id="btnAll" alignment="CENTER" contentDisplay="CENTER" prefHeight="42.0" prefWidth="210.0" styleClass="sf-filter-button" text="📋   Tất cả phiên" />
                <Button fx:id="btnUpcoming" prefHeight="42.0" prefWidth="210.0" styleClass="sf-filter-button" text="🕐   Sắp diễn ra" />
                <Button fx:id="btnRunning" prefHeight="42.0" prefWidth="210.0" styleClass="sf-filter-button" text="🔴   Đang diễn ra" />
                <Button fx:id="btnEnded" prefHeight="42.0" prefWidth="210.0" styleClass="sf-filter-button" text="✅   Đã kết thúc" />
            </VBox>

            <VBox alignment="CENTER" spacing="8.0" styleClass="sf-card-soft">
                <Label alignment="CENTER" prefHeight="16.0" prefWidth="153.0" style="-fx-font-size: 11px; -fx-text-fill: -sf-muted; -fx-font-weight: bold;" text="LOẠI SẢN PHẨM" />
                <ComboBox fx:id="categoryFilter" prefHeight="40.0" prefWidth="210.0" promptText="Tất cả loại" style="-fx-background-color: -sf-surface; -fx-border-color: -sf-border-soft; -fx-border-radius: 14; -fx-background-radius: 14; -fx-padding: 2 8 2 8;">
               <cursor>
                  <Cursor fx:constant="DEFAULT" />
               </cursor></ComboBox>
            </VBox>

            <VBox alignment="CENTER" prefHeight="234.0" prefWidth="184.0" spacing="8.0" styleClass="sf-card-soft">
                <Label alignment="CENTER" prefHeight="16.0" prefWidth="140.0" style="-fx-font-size: 11px; -fx-text-fill: -sf-muted; -fx-font-weight: bold;" text="ĐIỀU HƯỚNG" />
                <Button fx:id="btnHome" alignment="CENTER" contentDisplay="CENTER" nodeOrientation="LEFT_TO_RIGHT" onAction="#btnHome" prefHeight="38.0" prefWidth="234.0" styleClass="sf-btn-secondary" text="Trang chủ" />
                <Button fx:id="btnmanageProducts" onAction="#manageProducts" prefHeight="39.0" prefWidth="210.0" styleClass="sf-btn-secondary" text="Quản lý sản phẩm" />
                <Button fx:id="btnprofile" onAction="#goToProfile" prefHeight="39.0" prefWidth="210.0" styleClass="sf-btn-secondary" text="Thông tin User" />
                <Button fx:id="logOut1" onAction="#logOut1" prefHeight="39.0" prefWidth="210.0" styleClass="sf-btn-danger" text="Đăng xuất" />
            </VBox>

            <Region VBox.vgrow="ALWAYS" />
        </VBox>
    </left>

    <!-- ==================== NỘI DUNG CHÍNH ==================== -->
    <center>
        <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-padding: 0;">
            <VBox prefHeight="606.0" prefWidth="1051.0" spacing="15" style="-fx-padding: 18 22 14 22; -fx-background-color: linear-gradient(to bottom right, -sf-surface, -sf-page-soft);">

                <!-- Tiêu đề + Kết quả -->
                <HBox alignment="CENTER_LEFT">
                    <Label fx:id="sectionTitle" styleClass="sf-section-title" text="📋  TẤT CẢ PHIÊN ĐẤU GIÁ" />
                    <Region HBox.hgrow="ALWAYS" />
                </HBox>

                <!-- ==================== DANH SÁCH PHIÊN ĐẤU GIÁ ==================== -->
                <StackPane style="-fx-padding: 13;" styleClass="sf-card" VBox.vgrow="ALWAYS">
                    <ListView fx:id="featuredProductList" styleClass="sf-transparent-list" />
                </StackPane>

            </VBox>
        </ScrollPane>
    </center>

    <!-- ==================== FOOTER ==================== -->
    <bottom>
        <HBox alignment="CENTER" styleClass="sf-footer">
            <Label style="-fx-font-size: 12px; -fx-text-fill: -sf-danger;" text="© 2026 SnowFox - Studio SnowFlake" />
        </HBox>
    </bottom>
</BorderPane>
