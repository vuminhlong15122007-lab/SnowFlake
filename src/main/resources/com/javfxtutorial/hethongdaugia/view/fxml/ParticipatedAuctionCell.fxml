<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<AnchorPane prefHeight="180.0" prefWidth="780.0"
            style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-radius: 12; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 8, 0, 0, 2);"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.javfxtutorial.hethongdaugia.client.controller.ParticipatedAuctionCellController">

    <HBox alignment="CENTER_LEFT" spacing="20.0"
          AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0"
          AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0">

        <!-- ẢNH SẢN PHẨM -->
        <StackPane prefHeight="150.0" prefWidth="150.0"
                   style="-fx-background-color: #f8f9fa; -fx-background-radius: 12;">
            <ImageView fx:id="productImage" fitHeight="120.0" fitWidth="120.0"
                       pickOnBounds="true" preserveRatio="true" />
        </StackPane>

        <!-- THÔNG TIN CHÍNH -->
        <VBox prefHeight="147.0" prefWidth="300.0" spacing="8.0" HBox.hgrow="ALWAYS">
            <Label fx:id="lbCategory" style="-fx-font-size: 12px; -fx-text-fill: #95a5a6;" text="Loại sản phẩm" />
            <Label fx:id="lbProductName" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Tên sản phẩm" />
            <HBox spacing="4">
                <Label style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d;" text="Người dẫn đầu: " />
                <Label fx:id="lbWinnerName" style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d;" text="—" />
            </HBox>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d;" text="Giá hiện tại" />
                <Label fx:id="lbCurrentPrice" style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #e74c3c;" text="5,000,000 VND" />
            </HBox>
        </VBox>

        <Pane prefWidth="20.0" />

        <!-- NÚT HÀNH ĐỘNG + COUNTDOWN BADGE -->
        <VBox alignment="CENTER" prefWidth="160.0" spacing="10.0">
            <Button fx:id="actionButton" disable="true" onAction="#goPayment"
                    prefHeight="42.0" prefWidth="150.0"
                    style="-fx-background-color: #bdc3c7; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-background-radius: 25; -fx-cursor: hand;"
                    text="TRẠNG THÁI" />

            <!-- Countdown badge — chỉ hiện khi có thời gian đếm ngược -->
            <StackPane fx:id="countdownBadge" visible="false" managed="false">
                <Rectangle arcHeight="20" arcWidth="20" fill="#fff8e1"
                           stroke="#f39c12" strokeWidth="1.5"
                           width="150" height="36" />
                <HBox alignment="CENTER" spacing="5">
                    <Label style="-fx-font-size: 11px; -fx-text-fill: #e67e22; -fx-font-weight: bold;" text="⏱" />
                    <Label fx:id="lbTime"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #e67e22;"
                           text="24:00:00" />
                </HBox>
            </StackPane>

        </VBox>
    </HBox>
</AnchorPane>
