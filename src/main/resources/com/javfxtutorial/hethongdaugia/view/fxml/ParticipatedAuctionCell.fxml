<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<AnchorPane prefHeight="152.0" prefWidth="896.0" stylesheets="@../css/global.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javfxtutorial.hethongdaugia.client.controller.ParticipatedAuctionCellController">
    <styleClass>
        <String fx:value="sf-card" />
        <String fx:value="sf-participated-auction-cell" />
    </styleClass>

    <HBox alignment="CENTER_LEFT" spacing="20.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0">

        <!-- ẢNH SẢN PHẨM -->
        <StackPane prefHeight="121.0" prefWidth="120.0" style="-fx-background-color: -sf-surface-muted; -fx-background-radius: 12;">
            <ImageView fx:id="productImage" fitHeight="120.0" fitWidth="120.0" pickOnBounds="true" preserveRatio="true" />
        </StackPane>

        <!-- THÔNG TIN CHÍNH -->
        <VBox prefHeight="148.0" prefWidth="220.0" spacing="8.0" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label fx:id="lbCategory" styleClass="sf-chip" text="Loại sản phẩm" />
            </HBox>
            <Label fx:id="lbProductName" style="-fx-font-size: 20px;" styleClass="sf-section-title" text="Tên sản phẩm" />
            <HBox alignment="CENTER_LEFT" prefHeight="50.0" prefWidth="207.0" spacing="6" style="-fx-background-color: -sf-panel; -fx-background-radius: 16; -fx-border-color: -sf-accent; -fx-border-radius: 16; -fx-padding: 7 11;">
                <Label style="-fx-font-size: 13px; -fx-text-fill: -sf-warning;" text="👑" />
                <VBox spacing="0">
                    <Label style="-fx-font-size: 10px; -fx-text-fill: -sf-subtle;" text="Người dẫn đầu" />
                    <Label fx:id="lbWinnerName" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: -sf-muted;" text="—" />
                </VBox>
            </HBox>
        </VBox>

        <Pane prefHeight="120.0" prefWidth="403.0" />

        <!-- NÚT HÀNH ĐỘNG + COUNTDOWN BADGE -->
        <VBox alignment="CENTER" prefHeight="120.0" prefWidth="231.0" spacing="10.0">
             <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: -sf-subtle;" text="Giá hiện tại" />
            <HBox alignment="CENTER" spacing="8">
                <Label fx:id="lbCurrentPrice" alignment="CENTER" prefHeight="26.0" prefWidth="128.0" style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: -sf-danger;" text="5,000,000 VND" />
            </HBox>
            <Button fx:id="actionButton" disable="true" onAction="#goPayment" prefHeight="42.0" prefWidth="150.0" style="-fx-font-size: 13px;" styleClass="sf-auction-action-neutral" text="TRẠNG THÁI" />

            <!-- Countdown badge — chỉ hiện khi có thời gian đếm ngược -->
            <StackPane fx:id="countdownBadge" managed="false" visible="false">
                <Rectangle arcHeight="20" arcWidth="20" height="36" strokeWidth="1.5" style="-fx-fill: -sf-warning-soft; -fx-stroke: -sf-warning;" width="150" />
                <HBox alignment="CENTER" spacing="5">
                    <Label style="-fx-font-size: 11px; -fx-text-fill: -sf-warning; -fx-font-weight: bold;" text="⏱" />
                    <Label fx:id="lbTime" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: -sf-warning;" text="24:00:00" />
                </HBox>
            </StackPane>

        </VBox>
    </HBox>
</AnchorPane>
