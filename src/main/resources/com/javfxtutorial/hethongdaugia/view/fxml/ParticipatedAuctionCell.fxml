<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<AnchorPane prefHeight="152.0" prefWidth="896.0" style="-fx-background-color: gradient; -fx-border-color: #2f80ed; -fx-border-radius: 12; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 8, 0, 0, 2);" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javfxtutorial.hethongdaugia.client.controller.ParticipatedAuctionCellController">

    <HBox alignment="CENTER_LEFT" spacing="20.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0">

        <!-- ẢNH SẢN PHẨM -->
        <StackPane prefHeight="121.0" prefWidth="120.0" style="-fx-background-color: #f8f9fa; -fx-background-radius: 12;">
            <ImageView fx:id="productImage" fitHeight="120.0" fitWidth="120.0" pickOnBounds="true" preserveRatio="true" />
        </StackPane>

        <!-- THÔNG TIN CHÍNH -->
        <VBox prefHeight="148.0" prefWidth="220.0" spacing="8.0" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label fx:id="lbCategory" style="-fx-background-color: rgba(86,204,242,0.14); -fx-background-radius: 12; -fx-padding: 4 10; -fx-text-fill: #2f80ed; -fx-font-size: 11px; -fx-font-weight: bold;" text="Loại sản phẩm" />
            </HBox>
            <Label fx:id="lbProductName" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: linear-gradient(to bottom right, blue , purple);;" text="Tên sản phẩm" />
            <HBox alignment="CENTER_LEFT" prefHeight="50.0" prefWidth="207.0" spacing="6" style="-fx-background-color: rgba(255,255,255,0.66); -fx-background-radius: 16; -fx-border-color: #2f80ed; -fx-border-radius: 16; -fx-padding: 7 11;">
                <Label style="-fx-font-size: 13px; -fx-text-fill: gold;" text="👑" />
                <VBox spacing="0">
                    <Label style="-fx-font-size: 10px; -fx-text-fill: #7d8faf;" text="Người dẫn đầu" />
                    <Label fx:id="lbWinnerName" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #61708a;" text="—" />
                </VBox>
            </HBox>
        </VBox>

        <Pane prefHeight="120.0" prefWidth="403.0" />

        <!-- NÚT HÀNH ĐỘNG + COUNTDOWN BADGE -->
        <VBox alignment="CENTER" prefHeight="120.0" prefWidth="231.0" spacing="10.0">
             <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #7f8c8d;" text="Giá hiện tại" />
            <HBox alignment="CENTER" spacing="8">
                <Label fx:id="lbCurrentPrice" alignment="CENTER" prefHeight="26.0" prefWidth="128.0" style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #e74c3c;" text="5,000,000 VND" />
            </HBox>
            <Button fx:id="actionButton" disable="true" onAction="#goPayment" prefHeight="42.0" prefWidth="150.0" style="-fx-background-color: #bdc3c7; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-background-radius: 25; -fx-cursor: hand;" text="TRẠNG THÁI" />

            <!-- Countdown badge — chỉ hiện khi có thời gian đếm ngược -->
            <StackPane fx:id="countdownBadge" managed="false" visible="false">
                <Rectangle arcHeight="20" arcWidth="20" fill="#fff8e1" height="36" stroke="#f39c12" strokeWidth="1.5" width="150" />
                <HBox alignment="CENTER" spacing="5">
                    <Label style="-fx-font-size: 11px; -fx-text-fill: #e67e22; -fx-font-weight: bold;" text="⏱" />
                    <Label fx:id="lbTime" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #e67e22;" text="24:00:00" />
                </HBox>
            </StackPane>

        </VBox>
    </HBox>
</AnchorPane>
