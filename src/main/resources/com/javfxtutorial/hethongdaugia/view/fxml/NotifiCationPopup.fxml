<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
    NotifiCationPopup.fxml
    Popup thông báo dành cho Seller — dùng ListView + NotificationCellPopup.fxml.
-->
<VBox maxWidth="420.0" minWidth="360.0" prefWidth="400.0"
      styleClass="sf-popup"
      stylesheets="@../css/global.css"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.javfxtutorial.hethongdaugia.client.controller.NotifiCationPopupController">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="sf-popup-header">
        <Label styleClass="sf-popup-title" text="🔔  Thông báo của bạn" />
        <Region HBox.hgrow="ALWAYS" />
    </HBox>

    <!-- ListView thông báo -->
    <ListView fx:id="notificationListView"
              maxHeight="360.0" prefHeight="320.0"
              style="-fx-background-color: transparent; -fx-background-insets: 0; -fx-control-inner-background: transparent; -fx-padding: 6 4 6 4;" />

    <!-- Label khi không có thông báo -->
    <Label fx:id="emptyLabel" alignment="CENTER" maxWidth="Infinity"
           style="-fx-font-size: 13px; -fx-text-fill: -sf-muted; -fx-padding: 24 0 24 0;"
           text="Không có thông báo nào." visible="false" managed="false" />

    <!-- Footer -->
    <HBox alignment="CENTER" prefHeight="36.0" styleClass="sf-popup-footer">
        <Label style="-fx-font-size: 10px; -fx-text-fill: -sf-subtle;" text="© SnowFox – Hệ thống đấu giá" />
    </HBox>
</VBox>
