<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<HBox alignment="CENTER_LEFT" prefHeight="65.0" prefWidth="227.0" spacing="12.0" style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-width: 0 0 1 0;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javfxtutorial.hethongdaugia.client.controller.BidTransactionCellController">
    <padding>
        <Insets bottom="12.0" left="10.0" right="10.0" top="12.0" />
    </padding>

    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
         <Label fx:id="bidderNameLabel" style="-fx-text-fill: #1e90ff;" text="Nguyễn Văn A">
             <font>
                 <Font name="System Bold" size="14.0" />
             </font>
         </Label>

        <Label fx:id="amountLabel" style="-fx-text-fill: #e04a00;" text="15,000,000 đ">
            <font>
                <Font name="System Bold" size="13.0" />
            </font>
        </Label>
         <Label fx:id="timestampLabel" style="-fx-text-fill: #9ca3af;" text="23:09 20/04">
             <font>
                 <Font size="11.0" />
             </font>
         </Label>

    </VBox>
</HBox>
