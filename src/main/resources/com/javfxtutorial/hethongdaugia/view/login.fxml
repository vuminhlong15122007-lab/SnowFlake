<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="500" prefWidth="900" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javfxtutorial.hethongdaugia.client.controller.LoginController">

    <children>

        <!-- BACKGROUND -->
        <Pane prefHeight="500" prefWidth="900" style="-fx-background-color: linear-gradient(to right, #e0f7ff, #ffffff, #d6f0ff);" />

        <!-- LEFT PANEL (branding) -->
        <VBox alignment="CENTER" layoutX="50" layoutY="100" prefHeight="142.0" prefWidth="320.0" spacing="15">
         <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
            <children>
               <ImageView fitHeight="100.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="true">
                  <image>
                     <Image url="@../assets/Logo.png" />
                  </image>
               </ImageView>
               <Label prefHeight="100.0" prefWidth="186.0" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #56ccf2;" text="SnowFox" />
            </children>
         </HBox>
            <Label style="-fx-font-size: 18px; -fx-text-fill: #2f80ed; -fx-font-weight: bold;" text="Phát triển bởi SnowFlake Studio!" />
        </VBox>


        <!-- LOGIN CARD -->
        <VBox alignment="CENTER" layoutX="550" layoutY="80" prefHeight="360" prefWidth="300" spacing="15" style="-fx-background-color: rgba(255,255,255,0.6);                      -fx-background-radius: 25;                      -fx-padding: 30;                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 25, 0, 0, 10);">

            <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2b5876;" text="Login" />

            <TextField fx:id="Username" prefHeight="40" promptText="Username" style="-fx-background-radius: 12;                               -fx-background-color: white;" />

            <PasswordField fx:id="Password" prefHeight="40" promptText="Password" style="-fx-background-radius: 12;                                   -fx-background-color: white;" />
         <Label alignment="CENTER" prefHeight="18.0" prefWidth="145.0" text="Trạng thái đăng nhập" />

            <!-- LOGIN BUTTON -->
            <Button fx:id="login" onAction="#clickLogin" prefHeight="40" prefWidth="220" style="-fx-background-radius: 20;                            -fx-background-color: linear-gradient(to right, #56ccf2, #2f80ed);                            -fx-text-fill: white;                            -fx-font-weight: bold;" text="LOGIN" />

            <!-- REGISTER BUTTON -->
            <Button id="sign_in" fx:id="sign_in" onAction="#clickCreateAccount" prefHeight="35" prefWidth="220" style="-fx-background-radius: 20; -fx-background-color: transparent;                            -fx-border-color: #2f80ed;                            -fx-border-radius: 20;                            -fx-text-fill: #2f80ed;" text="CREATE ACCOUNT" />
<!--         <Button fx:id="sign_in" mnemonicParsing="false" onAction="#clickCreateAccount" style="-fx-text-fill: #7aaed6; -fx-underline: true; -fx-background-color: transparent;" text="Forgot password?" />-->

        </VBox>


    </children>
</AnchorPane>
