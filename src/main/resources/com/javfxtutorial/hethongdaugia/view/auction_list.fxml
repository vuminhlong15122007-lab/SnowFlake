<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="500.0" prefWidth="900.0" style="-fx-background-color: linear-gradient(to bottom, #e6f7ff, #ffffff);" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
   <top>
      <HBox prefHeight="83.0" prefWidth="370.0" style="-fx-background-color: linear-gradient(to right, skyblue, #2f80ed); -fx-padding: 15px;" BorderPane.alignment="CENTER">
         <children>
            <Pane prefHeight="53.0" prefWidth="902.0">
               <children>
                  <Button fx:id="search" layoutX="717.0" layoutY="12.0" mnemonicParsing="false" style="-fx-background-color: skyblue; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-border-radius: 10;" text="Search" />
                  <Button layoutX="795.0" layoutY="11.0" mnemonicParsing="false" prefHeight="32.0" style="-fx-background-color: #4b0082; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6;" text="Đăng xuất" />
                  <TextField fx:id="searchField" layoutX="489.0" layoutY="14.0" promptText="Tìm kiếm phiên đấu giá . . ." style="-fx-pref-width: 200; -fx-background-color: white; -fx-background-radius: 5;" />
                  <Label layoutX="66.0" layoutY="13.0" prefHeight="32.0" prefWidth="150.0" style="-fx-text-fill: linear-gradient(to right, purple, #2f80ed); -fx-font-size: 22px; -fx-font-weight: bold;" text="SnowFox" />
                  <ImageView fitHeight="58.0" fitWidth="79.0" layoutX="-5.0" layoutY="-1.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../assets/ClassicLogo.png" />
                     </image></ImageView>

               </children>
            </Pane>
         </children>
      </HBox>
   </top>
   <left>
      <VBox spacing="15" style="-fx-background-color: #f0f8ff; -fx-padding: 15; -fx-pref-width: 180;">
         <Button fx:id="homeButton" prefHeight="34.0" prefWidth="145.0" style="-fx-background-color: linear-gradient(to right, skyblue, #2f80ed); -fx-text-fill: white; -fx-background-radius: 6; -fx-font-weight: bold;" text="Trang chủ" />
         <Button fx:id="liveAuctionButton" prefHeight="35.0" prefWidth="145.0" style="-fx-background-color: linear-gradient(to right, skyblue, #2f80ed); -fx-text-fill: white; -fx-border-radius: 6; -fx-font-weight: bold;" text="Phiên đấu giá " />
         <Button fx:id="manageProductsButton" prefHeight="34.0" prefWidth="145.0" style="-fx-background-color: linear-gradient(to right, skyblue, #2f80ed); -fx-font-weight: bold; -fx-border-radius: 6; -fx-text-fill: white;" text="Quản lý sản phẩm" />
         <Button fx:id="profileButton" prefHeight="34.0" prefWidth="145.0" style="-fx-background-color: linear-gradient(to right, skyblue, #2f80ed); -fx-font-weight: bold; -fx-border-radius: 6; -fx-text-fill: white;" text="Thông tin người dùng" />
      </VBox>
   </left>

   <center>
      <VBox spacing="20" style="-fx-padding: 20;">
         <Label style="-fx-font-size: 18px; -fx-text-fill: #333366; -fx-font-weight: bold;" text="Sản phẩm nổi bật" />

         <!-- ListView hiển thị sản phẩm nổi bật -->
         <ListView fx:id="featuredProductList" prefHeight="300">
            <!-- mỗi item sẽ là custom cell có ảnh + tên + giá -->
         </ListView>
      </VBox>
   </center>

   <bottom>
      <HBox prefHeight="22.0" prefWidth="600.0" style="-fx-background-color: #b3c6ff; -fx-padding: 8;" BorderPane.alignment="CENTER">
         <children>
            <Label alignment="CENTER" prefHeight="18.0" prefWidth="876.0" style="-fx-text-fill: white; -fx-font-size: 12px;" text="© 2026 SnowFox - Studio SnowFlake" textAlignment="CENTER" />
         </children>
      </HBox>
   </bottom>
</BorderPane>
