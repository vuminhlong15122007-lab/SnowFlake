<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="500" prefWidth="900" style="-fx-background-color: linear-gradient(to bottom, #e6f7ff, #ffffff);" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javfxtutorial.hethongdaugia.client.controller.LiveAuctionController">

    <!-- Header -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-background-color: linear-gradient(to right, #89CFF0,lavender); -fx-padding: 10;">
         <ImageView fitHeight="68.0" fitWidth="68.0" pickOnBounds="true" preserveRatio="true">
            <image>
               <Image url="@../assets/ClassicLogo.png" />
            </image>
         </ImageView>
            <Label prefHeight="39.0" prefWidth="343.0" style="-fx-font-size: 27; -fx-text-fill: linear-gradient(to right, purple, #2f80ed); -fx-font-weight: bold;" text="SnowFox - Trang đấu giá " />
         <Region prefHeight="68.0" prefWidth="317.0" />
         <Button alignment="CENTER" mnemonicParsing="false" onAction="#goMenu" prefHeight="52.0" prefWidth="105.0" style="-fx-background-color: linear-gradient(to right, #56ccf2, #2f80ed); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 15;" text="Quay lại Menu" />
        </HBox>
    </top>

    <!-- Nội dung chính -->
    <center>
        <HBox alignment="CENTER" spacing="20" style="-fx-padding: 20;">
            <!-- Khung ảnh sản phẩm -->
            <VBox alignment="CENTER" prefHeight="338.0" prefWidth="290.0" spacing="10" style="-fx-background-color: #ffffff; -fx-padding: 15; -fx-background-radius: 20; -fx-border-color: #b3c6ff; -fx-border-radius: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 8,0,0,2);">
                <ImageView fx:id="itemImageView" fitHeight="248.0" fitWidth="255.0" preserveRatio="true" />
                <Label fx:id="itemNameLb" style="-fx-font-size: 20px; -fx-text-fill: linear-gradient(to right, purple, #2f80ed); -fx-font-weight: bold;" text="Tên sản phẩm" />
            </VBox>

            <!-- Khung thông tin đấu giá -->
            <VBox alignment="TOP_CENTER" prefHeight="338.0" prefWidth="290.0" spacing="15" style="-fx-background-color: #f0f8ff; -fx-padding: 20; -fx-background-radius: 15; -fx-border-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 6,0,0,2); -fx-border-color: #b3c6ff;">
                <Label prefHeight="33.0" prefWidth="154.0" style="-fx-font-size: 18px; -fx-text-fill: linear-gradient(to right, purple, #2f80ed); -fx-font-weight: bold;" text="Thông tin đấu giá" />
            <HBox prefHeight="27.0" prefWidth="236.0">
               <children>
                      <Label prefHeight="26.0" prefWidth="97.0" style="-fx-font-size: 16px; -fx-text-fill: #333366;" text="Giá hiện tại: " />
                  <Label fx:id="currentPrice_tf" prefHeight="35.0" prefWidth="143.0" style="-fx-text-fill: #333366;" text="....">
                     <font>
                        <Font size="16.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
            <HBox prefHeight="23.0" prefWidth="236.0">
               <children>
                  <Label prefHeight="26.0" prefWidth="97.0" style="-fx-font-size: 16px; -fx-text-fill: #333366;" text="Bước giá:" />
                  <Label fx:id="stepPrice_tf" prefHeight="35.0" prefWidth="141.0" style="-fx-text-fill: #333366;" text="....">
                     <font>
                        <Font size="16.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
            <HBox prefHeight="27.0" prefWidth="263.0" spacing="6.0">
               <children>
                      <Label prefHeight="20.0" prefWidth="165.0" style="-fx-font-size: 14px; -fx-text-fill: #333366;" text="Người đặt giá cao nhất: " />
                  <Label fx:id="highestPayer_tf" prefHeight="35.0" prefWidth="82.0" style="-fx-text-fill: #333366;" text="....">
                     <font>
                        <Font size="16.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
            <HBox prefHeight="27.0" prefWidth="263.0" spacing="6.0">
               <children>
                      <Label prefHeight="25.0" prefWidth="131.0" style="-fx-font-size: 16px; -fx-text-fill: #d9534f; -fx-font-weight: bold;" text="Thời gian còn lại:" />
                  <Label style="-fx-text-fill: #d9534f; -fx-font-weight: bold;" text="Time">
                     <font>
                        <Font size="16.0" />
                     </font>
                  </Label>
               </children>
               <VBox.margin>
                  <Insets />
               </VBox.margin>
            </HBox>

                <!-- Khu vực đặt giá -->
                <HBox alignment="CENTER" spacing="10">
                    <TextField fx:id="priceInput_tf" promptText="Nhập giá của bạn..." style="-fx-pref-width: 200; -fx-background-color: #ffffff; -fx-border-color: #b3c6ff; -fx-border-radius: 5;" />
                </HBox>
                 <Button fx:id="placeBidButton" onAction="#placeBid" style="-fx-background-color: linear-gradient(to right, purple, #2f80ed); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6;" text="Đặt giá" />
            </VBox>
   
             <!-- Danh sách người tham gia -->
             <VBox alignment="CENTER_LEFT" prefHeight="338.0" prefWidth="265.0" spacing="8" style="-fx-background-color: #f0f8ff; -fx-padding: 15; -fx-background-radius: 15; -fx-border-color: #b3c6ff; -fx-border-radius: 15;">
                 <Label style="-fx-font-size: 16px; -fx-text-fill: linear-gradient(to right, purple, #2f80ed); -fx-font-weight: bold;" text="Lịch sử phiên đấu giá :" />
                 <ListView fx:id="participantsList" prefHeight="279.0" prefWidth="190.0" style="-fx-background-radius: 0; -fx-text-fill: black;" />
             </VBox>
        </HBox>
    </center>

    <!-- Footer -->
    <bottom>
        <HBox alignment="CENTER" style="-fx-background-color: #b3c6ff; -fx-padding: 8;">
            <Label style="-fx-text-fill: white; -fx-font-size: 12px;" text="© 2026 SnowFox - Studio SnowFlake" />
        </HBox>
    </bottom>
</BorderPane>
