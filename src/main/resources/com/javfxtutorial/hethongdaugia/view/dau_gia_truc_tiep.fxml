<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="500" prefWidth="900" style="-fx-background-color: linear-gradient(to bottom, #e6f7ff, #ffffff);" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.LiveAuctionController">

    <!-- Header -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-background-color: #b3c6ff; -fx-padding: 10;">
         <ImageView fitHeight="68.0" fitWidth="68.0" pickOnBounds="true" preserveRatio="true">
            <image>
               <Image url="@../assets/Logo.png" />
            </image>
         </ImageView>
            <Label style="-fx-font-size: 27; -fx-text-fill: linear-gradient(to right, purple, #2f80ed); -fx-font-weight: bold;" text="SnowFox" />
         <Region prefHeight="68.0" prefWidth="545.0" />
         <Button alignment="CENTER" mnemonicParsing="false" prefHeight="52.0" prefWidth="105.0" style="-fx-background-color: linear-gradient(to right, #56ccf2, #2f80ed); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 15;" text="Quay lại Menu" />
        </HBox>
    </top>

    <!-- Nội dung chính -->
    <center>
        <HBox alignment="CENTER" spacing="20" style="-fx-padding: 20;">
            <!-- Khung ảnh sản phẩm -->
            <VBox alignment="CENTER" prefHeight="338.0" prefWidth="290.0" spacing="10" style="-fx-background-color: #ffffff; -fx-padding: 15; -fx-background-radius: 20; -fx-border-color: #b3c6ff; -fx-border-radius: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 8,0,0,2);">
                <ImageView fx:id="productImage" fitHeight="147.0" fitWidth="255.0" preserveRatio="true" />
                <Label fx:id="productName" style="-fx-font-size: 20px; -fx-text-fill: linear-gradient(to right, purple, #2f80ed); -fx-font-weight: bold;" text="Tên sản phẩm" />
                <Label fx:id="productDescription" style="-fx-font-size: 14px; -fx-text-fill: #555555;" text="Mô tả sản phẩm" wrapText="true" />
            </VBox>

            <!-- Khung thông tin đấu giá -->
            <VBox alignment="TOP_CENTER" prefHeight="338.0" prefWidth="290.0" spacing="15" style="-fx-background-color: #f0f8ff; -fx-padding: 20; -fx-background-radius: 15; -fx-border-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 6,0,0,2); -fx-border-color: #b3c6ff;">
                <Label prefHeight="33.0" prefWidth="154.0" style="-fx-font-size: 18px; -fx-text-fill: linear-gradient(to right, purple, #2f80ed); -fx-font-weight: bold;" text="Thông tin đấu giá" />
                <Label fx:id="currentPrice" prefHeight="26.0" prefWidth="250.0" style="-fx-font-size: 16px; -fx-text-fill: #333366;" text="Giá hiện tại: ..." />
                <Label fx:id="highestBidder" prefHeight="20.0" prefWidth="250.0" style="-fx-font-size: 14px; -fx-text-fill: #333366;" text="Người đặt giá cao nhất: ..." />
                <Label fx:id="countdownLabel" style="-fx-font-size: 16px; -fx-text-fill: #d9534f; -fx-font-weight: bold;" text="Thời gian còn lại: 00:00" />

                <!-- Khu vực đặt giá -->
                <HBox alignment="CENTER" spacing="10">
                    <TextField fx:id="bidInput" promptText="Nhập giá của bạn..." style="-fx-pref-width: 200; -fx-background-color: #ffffff; -fx-border-color: #b3c6ff; -fx-border-radius: 5;" />
                </HBox>
                 <Button fx:id="placeBidButton" style="-fx-background-color: linear-gradient(to right, purple, #2f80ed); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6;" text="Đặt giá" />
            </VBox>
   
             <!-- Danh sách người tham gia -->
             <VBox alignment="CENTER_LEFT" prefHeight="338.0" prefWidth="265.0" spacing="8" style="-fx-background-color: #f0f8ff; -fx-padding: 15; -fx-background-radius: 15; -fx-border-color: #b3c6ff; -fx-border-radius: 15;">
                 <Label style="-fx-font-size: 16px; -fx-text-fill: linear-gradient(to right, purple, #2f80ed); -fx-font-weight: bold;" text="Lịch sử phiên đấu giá :" />
                 <ListView fx:id="participantsList" prefHeight="279.0" prefWidth="190.0" style="-fx-background-radius: 0; -fx-text-fill: black;" />
             </VBox>
        </HBox>
    </center>

    <!-- Footer -->
    <bottom>
        <HBox alignment="CENTER" style="-fx-background-color: #b3c6ff; -fx-padding: 8;">
            <Label style="-fx-text-fill: white; -fx-font-size: 12px;" text="© 2026 SnowFox - Studio SnowFlake" />
        </HBox>
    </bottom>
</BorderPane>
