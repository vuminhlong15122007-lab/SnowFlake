<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="500" prefWidth="900" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javfxtutorial.hethongdaugia.client.controller.RegisterController">

    <children>

        <!-- BACKGROUND -->
        <Pane prefHeight="500" prefWidth="900" style="-fx-background-color: linear-gradient(to right, #e0f7ff, #ffffff, #d6f0ff);" />

        <!-- LEFT PANEL -->
        <VBox layoutX="50" layoutY="120" spacing="15">
         <HBox alignment="CENTER" prefHeight="100.0" prefWidth="274.0">
            <children>
               <ImageView fitHeight="100.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="true"> <!--thuộc tính của ảnh-->
                  <image>
                     <Image url="@../assets/Logo.png" /> <!--đường dẫn của ảnh-->
                  </image>
               </ImageView>
                  <Label prefHeight="100.0" prefWidth="158.0" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #56ccf2;" text="SnowFox" />
            </children>
         </HBox>
            <Label style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #2f80ed;" text="Kỷ nguyên vươn mình cùng SnowFox " />
        </VBox>

        <!-- REGISTER CARD -->
        <VBox fx:id="rootVBox" alignment="CENTER" layoutX="550" layoutY="70" prefHeight="380" prefWidth="300" spacing="12" style="-fx-background-color: rgba(255,255,255,0.65);                      -fx-background-radius: 25;                      -fx-padding: 25;                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 25, 0, 0, 10);">

            <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2b5876;" text="Register" />

            <TextField fx:id="Username" prefHeight="38" promptText="Username" style="-fx-background-radius: 12;" />

            <TextField fx:id="Email" prefHeight="38" promptText="Email" style="-fx-background-radius: 12;" />

            <PasswordField fx:id="Password" prefHeight="38" promptText="Password" style="-fx-background-radius: 12;" />

            <PasswordField fx:id="Confirm_Password" prefHeight="38" promptText="Confirm Password" style="-fx-background-radius: 12;" />

            <CheckBox style="-fx-text-fill: #4e7ea8;" text="I agree to Terms" />

            <!-- REGISTER BUTTON -->
            <Button fx:id="Sign_up" onAction="#clickSignUp" prefHeight="38" prefWidth="200" style="-fx-background-radius: 20;                            -fx-background-color: linear-gradient(to right, #56ccf2, #2f80ed);                            -fx-text-fill: white;                            -fx-font-weight: bold;" text="SIGN UP" />

            <!-- BACK TO LOGIN -->
            <Button fx:id="backToLogin" onAction="#clickBackToLogin" prefHeight="32" prefWidth="200" style="-fx-background-color: transparent;                            -fx-text-fill: #2f80ed;" text="Back to Login" />

        </VBox>

    </children>
</AnchorPane>
